<header class="ad2e-header ad2e-monster-header">
  <img class="ad2e-portrait" src="{{actor.img}}" data-edit="img" alt="" width="72" height="72">
  <div class="ad2e-monster-title">
    <input class="ad2e-name" type="text" name="name" value="{{actor.name}}">
    <div class="ad2e-monster-line">
      <label>{{localize "AD2E.Monster.Role.label"}} <select name="system.role">{{selectOptions roles selected=system.role localize=true}}</select></label>
      <label>HP <input type="number" name="system.hp.value" value="{{system.hp.value}}"> / <input type="number" name="system.hp.max" value="{{system.hp.max}}"></label>
      {{#if editable}}<button type="button" data-action="rollHp" data-tooltip="{{hd.formula}}"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Monster.RollHp"}}</button>{{/if}}
      <button type="button" data-action="rollMorale" data-tooltip="{{localize 'AD2E.Monster.MoraleHint'}}"><i class="fa-solid fa-person-running"></i> {{localize "AD2E.Monster.Morale"}}</button>
      {{#if system.url}}<a class="ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{system.url}}"><i class="fa-solid fa-book-open"></i> {{sourceLabel}}</a>{{/if}}
    </div>
  </div>
  <dl class="ad2e-monster-summary">
    {{#each summary as |s|}}<div class="ad2e-summary-cell"><dt>{{s.label}}</dt><dd {{#if s.tooltip}}data-tooltip="{{s.tooltip}}"{{/if}}>{{s.value}}</dd></div>{{/each}}
  </dl>
</header>
