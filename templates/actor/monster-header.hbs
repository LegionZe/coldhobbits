<header class="ad2e-header ad2e-monster-header">
  <img class="ad2e-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-tooltip="{{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
  <div class="ad2e-monster-title">
    <input class="ad2e-name" type="text" name="name" value="{{actor.name}}">
    <div class="ad2e-monster-line">
      <label>{{localize "AD2E.Monster.Role.label"}} <select name="system.role">{{selectOptions roles selected=system.role localize=true}}</select></label>
      {{#if canPush}}{{#if editable}}<button type="button" data-action="pushMount" data-tooltip="{{localize 'AD2E.Push.Hint'}}"><i class="fa-solid fa-horse"></i> {{localize "AD2E.Push.Button"}}</button>{{/if}}{{#if pushText}}<span class="ad2e-unmet">{{pushText}}</span>{{/if}}{{/if}}
      {{#if isMount}}<label data-tooltip="{{localize 'AD2E.Mounted.TrainedHint'}}">{{localize "AD2E.Mounted.TrainedLabel"}} <select name="system.combatTrained">{{selectOptions trainedChoices selected=system.combatTrained blank=trainedAuto localize=true}}</select></label>{{/if}}
      {{#if editable}}<button type="button" data-action="breakFreeNet" data-tooltip="{{localize 'AD2E.Net.BreakFreeHint'}}"><i class="fa-solid fa-border-all"></i> {{localize "AD2E.Net.BreakFree"}}</button>{{/if}}
      <label>HP <input type="number" name="system.hp.value" value="{{system.hp.value}}"> / <input type="number" name="system.hp.max" value="{{system.hp.max}}"></label>
      {{#if dead}}<strong class="ad2e-unmet">{{localize "AD2E.Health.State.dead"}}</strong>{{/if}}
      {{#if knockedOut}}<strong class="ad2e-unmet">{{localize "AD2E.Health.State.unconscious"}}</strong>{{/if}}
      {{#if temporary}}<span data-tooltip="{{localize 'AD2E.Health.RecoverHint'}}">{{localize "AD2E.Health.Temporary"}}: {{temporary}}</span>
      {{#if editable}}<button type="button" data-action="recoverTemp" data-tooltip="{{localize 'AD2E.Health.Recover'}}"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}{{/if}}
      {{#if editable}}<button type="button" data-action="hpDamage" data-tooltip="{{localize 'AD2E.Health.Damage'}}"><i class="fa-solid fa-heart-crack"></i></button>
      <button type="button" data-action="hpHeal" data-tooltip="{{localize 'AD2E.Health.Heal'}}"><i class="fa-solid fa-heart-pulse"></i></button>
      <button type="button" data-action="rollSurprise" data-tooltip="{{localize 'AD2E.Surprise.Title'}}"><i class="fa-solid fa-eye"></i></button>
      <button type="button" data-action="rollReaction" data-tooltip="{{localize 'AD2E.Reaction.Title'}}"><i class="fa-solid fa-comments"></i></button>{{/if}}
      {{#if editable}}<button type="button" data-action="rollHp" data-tooltip="{{hd.formula}}"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Monster.RollHp"}}</button>{{/if}}
      {{#if showCost}}<label>{{localize "AD2E.Monster.Cost"}} <input type="text" name="system.cost" value="{{system.cost}}"></label>{{/if}}
      <button type="button" data-action="rollMorale" data-tooltip="{{localize 'AD2E.Monster.MoraleHint'}}"><i class="fa-solid fa-person-running"></i> {{localize "AD2E.Monster.Morale"}}</button>
      {{#if isGM}}<button type="button" data-action="rollTreasure" data-tooltip="{{localize 'AD2E.Treasure.ButtonHint'}}"><i class="fa-solid fa-sack-dollar"></i> {{localize "AD2E.Treasure.Button"}}</button>{{/if}}
      {{#if system.url}}<a class="ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{system.url}}"><i class="fa-solid fa-book-open"></i> {{sourceLabel}}</a>{{/if}}
    </div>
  </div>
  <dl class="ad2e-monster-summary">
    {{#each summary as |s|}}<div class="ad2e-summary-cell"><dt>{{s.label}}</dt><dd {{#if s.tooltip}}data-tooltip="{{s.tooltip}}"{{/if}}>{{s.value}}</dd></div>{{/each}}
  </dl>
</header>
