<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with classTab as |ct|}}
  <p class="ad2e-note">{{localize "AD2E.Class.DragHint"}}</p>
  <fieldset class="ad2e-race">
    <legend>{{localize "AD2E.Character.race"}}</legend>
    {{#if ct.raceItem}}
    <div class="ad2e-item-row">
      <img src="{{ct.raceItem.img}}" alt="" width="32" height="32">
      <h3><a data-action="openItem" data-item-id="{{ct.raceItem.id}}">{{ct.raceItem.name}}</a></h3>
      {{#if ct.race.url}}<a href="{{ct.race.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.url'}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>{{/if}}
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{ct.raceItem.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    <dl class="ad2e-facts">
      <dt>{{localize "AD2E.Race.Infravision"}}</dt><dd>{{ct.infravision}}</dd>
      <dt>{{localize "AD2E.Race.SaveBonus"}}</dt><dd>{{#if ct.conSaveBonus}}+{{ct.conSaveBonus}}{{else}}—{{/if}}</dd>
      <dt>{{localize "AD2E.Race.PoisonBonus"}}</dt><dd>{{#if ct.poisonBonus}}+{{ct.poisonBonus}}{{else}}—{{/if}}</dd>
    </dl>
    {{#if ct.needsRaceKit}}<p class="ad2e-unmet">{{localize "AD2E.Race.NeedsKitNote"}}</p>
    {{else}}{{#unless ct.classAllowedByRace}}<p class="ad2e-unmet">{{localize "AD2E.Race.ClassNotAllowed"}}</p>{{/unless}}{{/if}}
    <table class="ad2e-race-table">
      <thead><tr><th></th><th>{{localize "AD2E.Race.Min"}}</th><th>{{localize "AD2E.Race.Max"}}</th><th>{{localize "AD2E.Race.Rolled"}}</th><th>{{localize "AD2E.Race.Adjust"}}</th><th>{{localize "AD2E.Race.Effective"}}</th><th></th></tr></thead>
      <tbody>
        {{#each ct.raceRows as |r|}}
        <tr class="{{#unless r.met}}ad2e-unmet{{/unless}}"><th>{{r.label}}</th><td>{{r.min}}</td><td>{{r.max}}</td><td>{{r.rolled}}</td><td>{{r.adjust}}</td><td>{{r.total}}</td>
          <td>{{#if r.met}}<i class="fa-solid fa-check"></i>{{else}}<i class="fa-solid fa-xmark"></i>{{/if}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p>{{localize "AD2E.Race.DropRace"}}</p>
    {{/if}}
  </fieldset>

  <div class="ad2e-class-grid">
    <fieldset class="ad2e-class">
      <legend>{{localize "AD2E.Character.className"}}</legend>
      {{#if ct.classItem}}
      <div class="ad2e-item-row">
        <img src="{{ct.classItem.img}}" alt="" width="32" height="32">
        <h3><a data-action="openItem" data-item-id="{{ct.classItem.id}}">{{ct.classItem.name}}</a></h3>
        {{#if ct.cls.url}}<a href="{{ct.cls.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.url'}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>{{/if}}
        {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{ct.classItem.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </div>
      <dl class="ad2e-facts">
        <dt>{{localize "AD2E.Character.classGroup"}}</dt><dd>{{ct.groupLabel}} (d{{ct.hitDie}})</dd>
        <dt>{{localize "AD2E.Class.PrimeRequisites"}}</dt><dd>{{ct.prime}}</dd>
        {{#if ct.raceItem}}<dt>{{localize "AD2E.Race.LevelLimit"}}</dt><dd class="{{#if ct.overLevelLimit}}ad2e-unmet{{/if}}">{{#if ct.levelLimit}}{{ct.levelLimit}}{{else}}{{localize "AD2E.Race.Unlimited"}}{{/if}}</dd>{{/if}}
        <dt>{{localize "AD2E.HP.HitDice"}}</dt><dd>{{@root.system.hitDice.label}}</dd>
        <dt>{{localize "AD2E.HP.NextLevel"}}</dt><dd>{{#if @root.system.xpNext}}{{@root.system.xpNext}} XP{{#if @root.system.xpRestart}} <span class="ad2e-note">({{localize "AD2E.HP.XpRestart"}})</span>{{/if}}{{else}}—{{/if}}</dd>
        <dt>{{localize "AD2E.Class.XpBonus"}}</dt><dd>{{#if ct.xpBonus}}+{{ct.xpBonus}}%{{else}}—{{/if}}</dd>
        <dt>{{localize "AD2E.Class.Alignments"}}</dt><dd class="{{#unless ct.alignmentAllowed}}ad2e-unmet{{/unless}}">{{ct.alignments}}</dd>
        {{#if ct.cls.school}}
        <dt>{{localize "AD2E.Class.School"}}</dt><dd>{{ct.cls.school}}</dd>
        <dt>{{localize "AD2E.Class.Opposition"}}</dt><dd>{{ct.cls.opposition}}</dd>
        <dt>{{localize "AD2E.Class.Races"}}</dt><dd>{{ct.races}}</dd>
        {{/if}}
      </dl>
      {{else}}
      <p>{{localize "AD2E.Class.DropClass"}}</p>
      {{/if}}
    </fieldset>

    <fieldset class="ad2e-kit">
      <legend>{{localize "AD2E.Character.kit"}}</legend>
      {{#if ct.kitItem}}
      <div class="ad2e-item-row">
        <img src="{{ct.kitItem.img}}" alt="" width="32" height="32">
        <h3><a data-action="openItem" data-item-id="{{ct.kitItem.id}}">{{ct.kitItem.name}}</a></h3>
        {{#if ct.kit.url}}<a href="{{ct.kit.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.url'}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>{{/if}}
        {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{ct.kitItem.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </div>
      <dl class="ad2e-facts">
        <dt>{{localize "AD2E.Class.Source"}}</dt><dd>{{ct.kit.source}}</dd>
        {{#if ct.kitBonusProfs}}<dt>{{localize "AD2E.Prof.Bonus"}}</dt><dd>{{ct.kitBonusProfs}}</dd>{{/if}}
        {{#if ct.kitRequiredProfs}}<dt>{{localize "AD2E.Prof.Required"}}</dt><dd>{{ct.kitRequiredProfs}}</dd>{{/if}}
        {{#if ct.kitBonusSlots}}<dt>{{localize "AD2E.Prof.BonusSlots"}}</dt><dd>{{ct.kitBonusSlots}}</dd>{{/if}}
        {{#if ct.kitRaceLimits}}<dt>{{localize "AD2E.Race.KitRaceLimits"}}</dt><dd>{{ct.kitRaceLimits}}{{#if ct.kit.raceOnly}} ({{localize "AD2E.Race.RaceOnly"}}){{/if}}</dd>{{/if}}
      </dl>
      {{#unless ct.kitFits}}<p class="ad2e-unmet">{{localize "AD2E.Class.KitDoesNotFit"}}</p>{{/unless}}
      {{#if ct.kit.otherRequirements}}<p class="ad2e-note">{{localize "AD2E.Class.OtherRequirements"}}</p>{{/if}}
      {{else}}
      <p>{{localize "AD2E.Class.DropKit"}}</p>
      {{/if}}
    </fieldset>
  </div>

  <fieldset class="ad2e-requirements">
    <legend>{{localize "AD2E.Class.Requirements"}}</legend>
    <table>
      <thead><tr><th></th><th>{{localize "AD2E.Class.ClassMin"}}</th><th>{{localize "AD2E.Class.KitMin"}}</th><th>{{localize "AD2E.Class.Score"}}</th><th></th></tr></thead>
      <tbody>
        {{#each ct.requirements as |r|}}
        <tr class="{{#unless r.met}}ad2e-unmet{{/unless}}">
          <th>{{r.label}}</th><td>{{r.classMin}}</td><td>{{r.kitMin}}</td><td>{{r.score}}</td>
          <td>{{#if r.met}}<i class="fa-solid fa-check"></i>{{else}}<i class="fa-solid fa-xmark"></i>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </fieldset>
  {{/with}}

  <fieldset class="ad2e-class-notes">
    <legend>{{localize "AD2E.Class.Notes"}}</legend>
    <textarea name="system.classNotes" rows="6">{{system.classNotes}}</textarea>
  </fieldset>
</section>
