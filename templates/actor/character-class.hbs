<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with classTab as |ct|}}
  <div class="ad2e-class-grid">
    <fieldset class="ad2e-class">
      <legend>{{localize "AD2E.Character.className"}}</legend>
      {{#if ct.class}}
      <h3><a href="{{ct.class.url}}" target="_blank" rel="noopener">{{ct.class.name}}</a></h3>
      <dl class="ad2e-facts">
        <dt>{{localize "AD2E.Character.classGroup"}}</dt><dd>{{ct.groupLabel}} (d{{ct.hitDie}})</dd>
        <dt>{{localize "AD2E.Class.PrimeRequisites"}}</dt><dd>{{ct.prime}}</dd>
        <dt>{{localize "AD2E.Class.XpBonus"}}</dt><dd>{{#if ct.xpBonus}}+{{ct.xpBonus}}%{{else}}—{{/if}}</dd>
        <dt>{{localize "AD2E.Class.Alignments"}}</dt><dd class="{{#unless ct.alignmentAllowed}}ad2e-unmet{{/unless}}">{{ct.alignments}}</dd>
        {{#if ct.class.school}}
        <dt>{{localize "AD2E.Class.School"}}</dt><dd>{{ct.class.school}}</dd>
        <dt>{{localize "AD2E.Class.Opposition"}}</dt><dd>{{ct.class.opposition}}</dd>
        <dt>{{localize "AD2E.Class.Races"}}</dt><dd>{{ct.races}}</dd>
        {{/if}}
      </dl>
      {{else}}
      <p>{{localize "AD2E.Class.ChooseClass"}}</p>
      {{/if}}
    </fieldset>

    <fieldset class="ad2e-kit">
      <legend>{{localize "AD2E.Character.kit"}}</legend>
      {{#if ct.kit}}
      <h3><a href="{{ct.kit.url}}" target="_blank" rel="noopener">{{ct.kit.name}}</a></h3>
      <dl class="ad2e-facts">
        <dt>{{localize "AD2E.Class.Source"}}</dt><dd>{{ct.kit.source}}</dd>
      </dl>
      {{#if ct.kit.otherRequirements}}<p class="ad2e-note">{{localize "AD2E.Class.OtherRequirements"}}</p>{{/if}}
      {{else}}
      <p>{{#if ct.class}}{{localize "AD2E.Class.NoKitChosen"}}{{else}}{{localize "AD2E.Class.ChooseClass"}}{{/if}}</p>
      {{/if}}
    </fieldset>
  </div>

  <fieldset class="ad2e-requirements">
    <legend>{{localize "AD2E.Class.Requirements"}}</legend>
    <table>
      <thead><tr><th></th><th>{{localize "AD2E.Class.ClassMin"}}</th><th>{{localize "AD2E.Class.KitMin"}}</th><th>{{localize "AD2E.Class.Score"}}</th><th></th></tr></thead>
      <tbody>
        {{#each ct.requirements as |r|}}
        <tr class="{{#unless r.met}}ad2e-unmet{{/unless}}">
          <th>{{r.label}}</th><td>{{r.classMin}}</td><td>{{r.kitMin}}</td><td>{{r.score}}</td>
          <td>{{#if r.met}}<i class="fa-solid fa-check"></i>{{else}}<i class="fa-solid fa-xmark"></i>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </fieldset>
  {{/with}}

  <fieldset class="ad2e-class-notes">
    <legend>{{localize "AD2E.Class.Notes"}}</legend>
    <textarea name="system.classNotes" rows="6">{{system.classNotes}}</textarea>
  </fieldset>
</section>
