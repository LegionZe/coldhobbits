<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with profTab as |pt|}}
  <p class="ad2e-note">{{localize "AD2E.Prof.DragHint"}}</p>
  <div class="ad2e-prof-summary">
    <span class="{{#if pt.weapon.over}}ad2e-unmet{{/if}}">{{localize "AD2E.Prof.WeaponSlots"}}: <strong>{{pt.weapon.used}} / {{pt.weapon.available}}</strong></span>
    <span class="{{#if pt.nonweapon.over}}ad2e-unmet{{/if}}">{{localize "AD2E.Prof.NonweaponSlots"}}: <strong>{{pt.nonweapon.used}} / {{pt.nonweapon.available}}</strong></span>
    <span>{{localize "AD2E.Prof.Penalty"}}: <strong>{{#if pt.sp}}{{pt.spPenalty}}{{else}}{{pt.penalty}}{{/if}}</strong></span>
    <span>{{localize "AD2E.Prof.Groups"}}: {{pt.groups}}</span>
  </div>
  {{#if pt.specRule}}<p class="ad2e-note">{{localize "AD2E.Prof.KitSpecialization"}}: {{pt.specRule}}</p>{{/if}}
  {{#if pt.specMissing}}<p class="ad2e-unmet">{{localize "AD2E.Prof.SpecMissing"}}</p>{{/if}}
  {{#if pt.recommended}}<p class="ad2e-note">{{localize "AD2E.Prof.KitRecommended"}}: {{pt.recommended}}</p>{{/if}}

  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Prof.Weapon"}}</legend>
    {{#each pt.weapon.rows as |r|}}
    <div class="ad2e-prof-row ad2e-prof-row-weapon">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}</a>
        <span class="ad2e-weapon-meta">{{r.meta}}{{#if r.covered}} · {{localize "AD2E.SP.Covered"}}{{/if}}</span>
        {{#if r.invalidText}}<span class="ad2e-unmet">{{r.invalidText}}</span>{{/if}}
      </div>
      <label class="ad2e-spec {{#if r.specInvalid}}ad2e-unmet{{/if}}" data-tooltip="{{#if r.specInvalid}}{{localize 'AD2E.Weapon.SpecInvalid'}}{{else}}{{localize 'AD2E.Weapon.Specialize'}}{{/if}}">
        <input type="checkbox" data-action="toggleSpecialized" data-item-id="{{r.id}}" {{checked r.specialized}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.Weapon.Specialized"}}</label>
      {{#if pt.sp}}
      <label class="ad2e-spec" data-tooltip="{{localize 'AD2E.SP.ChoiceHint'}}">
        <input type="checkbox" data-action="toggleProfFlag" data-field="choice" data-item-id="{{r.id}}" {{checked r.choice}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.SP.Choice"}}</label>
      <label class="ad2e-spec" data-tooltip="{{localize 'AD2E.SP.ExpertiseHint'}}">
        <input type="checkbox" data-action="toggleProfFlag" data-field="expertise" data-item-id="{{r.id}}" {{checked r.expertise}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.SP.Expertise"}}</label>
      <label class="ad2e-spec {{#if r.masteryInvalid}}ad2e-unmet{{/if}}" data-tooltip="{{localize 'AD2E.SP.MasteryHint'}}">
        <input type="checkbox" data-action="toggleProfFlag" data-field="mastery" data-item-id="{{r.id}}" {{checked r.mastery}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.SP.Mastery"}}</label>
      {{/if}}
      <div class="ad2e-weapon-uses">
        {{#each r.uses as |u|}}
        <span class="ad2e-weapon-use">
          <button type="button" data-action="rollWeaponAttack" data-item-id="{{r.id}}" data-use="{{u.use}}">{{u.label}} {{u.hit}}</button>
          <button type="button" data-action="rollWeaponDamage" data-item-id="{{r.id}}" data-use="{{u.use}}" data-tooltip="{{u.damageHint}}">{{localize "AD2E.Weapon.Damage"}} {{u.dmg}}</button>
          <span class="ad2e-weapon-rate" data-tooltip="{{localize 'AD2E.Weapon.Rate'}}">{{u.rate}}</span>
          {{#if u.pointBlank}}<span class="ad2e-weapon-pb" data-tooltip="{{localize 'AD2E.Weapon.PointBlankHint'}}">PB</span>{{/if}}
        </span>
        {{else}}<span class="ad2e-placeholder">{{localize "AD2E.Weapon.NoWeaponData"}}</span>
        {{/each}}
      </div>
      <span class="ad2e-prof-cost" data-tooltip="{{r.costHint}}">{{#if r.granted}}{{localize "AD2E.Prof.KitBonus"}}{{#if r.cost}} +{{r.cost}}{{/if}}{{else}}{{r.cost}}{{/if}}</span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Prof.NoneYet"}}</p>
    {{/each}}
  </fieldset>

  {{#if pt.spRows.length}}
  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.SP.Legend"}}</legend>
    {{#unless pt.sp}}<p class="ad2e-unmet">{{localize "AD2E.SP.Off"}}</p>{{/unless}}
    {{#each pt.spRows as |r|}}
    <div class="ad2e-prof-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}</a>
        <span class="ad2e-weapon-meta">{{r.kind}} · {{r.effect}}</span>
        {{#if r.invalidText}}<span class="ad2e-unmet">{{r.invalidText}}</span>{{/if}}
      </div>
      {{#if r.improvable}}
      <label class="ad2e-spec" data-tooltip="{{localize 'AD2E.SP.ImprovedHint'}}">
        <input type="checkbox" data-action="toggleProfFlag" data-field="improved" data-item-id="{{r.id}}" {{checked r.improved}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.SP.Improved"}}</label>
      {{/if}}
      <span class="ad2e-prof-cost" data-tooltip="{{r.costHint}}">{{#if r.granted}}{{localize "AD2E.Prof.KitBonus"}}{{else}}{{r.cost}}{{/if}}</span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{/each}}
  </fieldset>
  {{/if}}

  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Prof.Nonweapon"}}</legend>
    {{#each pt.nonweapon.rows as |r|}}
    <div class="ad2e-prof-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}</a>
      <span class="ad2e-prof-check">{{r.ability}} {{r.modifier}}</span>
      {{#if r.target}}<button type="button" class="ad2e-prof-roll" data-action="rollProficiency" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Prof.CheckHint'}}">≤ {{r.target}}</button>{{else}}<span class="ad2e-prof-roll">—</span>{{/if}}
      <span class="ad2e-prof-cost {{#if r.crossGroup}}ad2e-unmet{{/if}}" data-tooltip="{{#if r.crossGroup}}{{localize 'AD2E.Prof.CrossGroup'}}{{else}}{{localize 'AD2E.Prof.SlotsUsed'}}{{/if}}">{{#if r.granted}}{{localize "AD2E.Prof.KitBonus"}}{{else}}{{r.cost}}{{/if}}</span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Prof.NoneYet"}}</p>
    {{/each}}
  </fieldset>

  {{#with pt.traits as |tr|}}
  <fieldset class="ad2e-prof-list">
    <legend data-tooltip="{{localize 'AD2E.Trait.SectionHint'}}">{{localize "AD2E.Trait.Section"}}</legend>
    <p class="ad2e-prof-summary {{#if tr.over}}ad2e-unmet{{/if}}">{{tr.balance}}{{#if tr.over}} — {{localize "AD2E.Trait.Over"}}{{/if}}</p>
    {{#each tr.traits as |r|}}
    <div class="ad2e-prof-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}</a>
      <span class="ad2e-weapon-meta">{{r.effects}}</span>
      <span class="ad2e-prof-cost" data-tooltip="{{localize 'AD2E.Trait.Cost'}}">{{r.value}}</span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{/each}}
    {{#each tr.disadvantages as |r|}}
    <div class="ad2e-prof-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}</a>
      <span class="ad2e-weapon-meta">{{#if r.canSevere}}{{#if @root.editable}}<a data-action="toggleSeverity" data-item-id="{{r.id}}">{{#if r.severe}}{{../severeLabel}}{{else}}{{../moderateLabel}}{{/if}}</a>{{else}}{{#if r.severe}}{{../severeLabel}}{{else}}{{../moderateLabel}}{{/if}}{{/if}}{{/if}}{{#if r.effects}} {{r.effects}}{{/if}}</span>
      <span class="ad2e-prof-cost" data-tooltip="{{localize 'AD2E.Trait.Points'}}">+{{r.value}}</span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{/each}}
    {{#unless tr.traits.length}}{{#unless tr.disadvantages.length}}<p class="ad2e-placeholder">{{localize "AD2E.Trait.DropHint"}}</p>{{/unless}}{{/unless}}
  </fieldset>
  {{/with}}
  {{/with}}
</section>
