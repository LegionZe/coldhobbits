<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="ad2e-monster-grid">
    <fieldset>
      <legend>{{localize "AD2E.Monster.Combat"}}</legend>
      <div class="ad2e-form-grid">
        <label>{{localize "AD2E.Monster.HitDice"}}</label><input type="text" name="system.hitDice" value="{{system.hitDice}}" data-tooltip="{{localize 'AD2E.Monster.HitDiceHint'}}">
        <label>{{localize "AD2E.Monster.Field.acBase"}}</label><input type="number" name="system.ac.base" value="{{system.ac.base}}">
        <label>{{localize "AD2E.Monster.Field.acText"}}</label><input type="text" name="system.ac.text" value="{{system.ac.text}}">
        <label>{{localize "AD2E.Monster.Field.movement"}}</label><input type="number" name="system.movement.base" value="{{system.movement.base}}">
        <label>{{localize "AD2E.Monster.Field.movementText"}}</label><input type="text" name="system.movement.text" value="{{system.movement.text}}">
        <label>{{localize "AD2E.Character.thac0Override"}}</label><input type="number" name="system.thac0.override" value="{{system.thac0.override}}" placeholder="{{system.thac0.computed}}">
        <label>{{localize "AD2E.Monster.Field.attacksText"}}</label><input type="text" name="system.attacksText" value="{{system.attacksText}}">
        <label>{{localize "AD2E.Monster.Field.damageText"}}</label><input type="text" name="system.damageText" value="{{system.damageText}}">
        <label>{{localize "AD2E.Monster.Morale"}}</label><input type="number" name="system.morale.value" value="{{system.morale.value}}">
        <label>{{localize "AD2E.Monster.Field.moraleText"}}</label><input type="text" name="system.morale.text" value="{{system.morale.text}}">
        <label>{{localize "AD2E.Character.initMod"}}</label><input type="number" name="system.initiative.mod" value="{{system.initiative.mod}}">
        <label data-tooltip="{{localize 'AD2E.Critical.BodyTypeHint'}}">{{localize "AD2E.Critical.BodyType"}}</label><select name="system.bodyType">{{selectOptions bodyTypes selected=system.bodyType blank=(localize "AD2E.Critical.Body.default") localize=true}}</select>
        {{#if isFollower}}<label data-tooltip="{{localize 'AD2E.Followers.UnitSizeHint'}}">{{localize "AD2E.Followers.UnitSize"}}</label><input type="number" name="system.unitSize" value="{{system.unitSize}}" min="1" step="1" placeholder="1">{{/if}}
      </div>
    </fieldset>

    <fieldset class="ad2e-saves">
      <legend>{{localize "AD2E.Character.saves"}}</legend>
      <div class="ad2e-form-grid">
        <label>{{localize "AD2E.Monster.SaveGroup"}}</label>
        <select name="system.saveGroup">{{selectOptions saveGroups selected=system.saveGroup localize=true}}</select>
      </div>
      <table class="ad2e-monster-saves">
        {{#each saves as |sv|}}
        <tr><td><a data-action="rollSave" data-save="{{sv.key}}">{{sv.label}}</a></td><td class="ad2e-num">{{sv.value}}</td>
          <td class="ad2e-note" data-tooltip="{{localize 'AD2E.Monster.SaveLevelHint'}}">{{localize "AD2E.Character.level"}} {{sv.level}}</td></tr>
        {{/each}}
      </table>
    </fieldset>
  </div>

  <fieldset>
    <legend>{{localize "AD2E.Monster.Attacks"}}</legend>
    {{#if system.damageText}}<p class="ad2e-note">{{localize "AD2E.Monster.Field.damageText"}}: {{system.damageText}}</p>{{/if}}
    {{#if elementGuess}}<p class="ad2e-note">{{elementGuess}}{{#if editable}} <button type="button" data-action="applyElementGuess">{{localize "AD2E.Monster.ElementGuessApply"}}</button>{{/if}}</p>{{/if}}
    <table class="ad2e-monster-attacks">
      <thead><tr><th>{{localize "AD2E.Monster.AttackName"}}</th><th>{{localize "AD2E.Weapon.Damage"}}</th><th>{{localize "AD2E.Monster.AttackBonus"}}</th><th data-tooltip="{{localize 'AD2E.Monster.ElementHint'}}">{{localize "AD2E.Monster.Element"}}</th><th data-tooltip="{{localize 'AD2E.Poison.AttackHint'}}">{{localize "AD2E.Poison.Poison"}}</th><th data-tooltip="{{localize 'AD2E.Table52.TypeHint'}}">{{localize "AD2E.Weapon.Type"}}</th><th></th></tr></thead>
      <tbody>
        {{#each naturalAttacks as |a|}}
        <tr>
          <td><input type="text" name="system.attacks.{{a.index}}.name" value="{{a.name}}"></td>
          <td><input type="text" name="system.attacks.{{a.index}}.damage" value="{{a.damage}}" data-tooltip="{{localize 'AD2E.Monster.DamageHint'}}"></td>
          <td><input type="number" name="system.attacks.{{a.index}}.bonus" value="{{a.bonus}}"></td>
          <td><select name="system.attacks.{{a.index}}.element">{{selectOptions @root.attackElements selected=a.element blank="—" localize=true}}</select></td>
          <td><select name="system.attacks.{{a.index}}.poison">{{selectOptions @root.poisonClasses selected=a.poison blank="—"}}</select></td>
          <td><select name="system.attacks.{{a.index}}.type">{{selectOptions @root.attackTypes selected=a.type blank="—"}}</select></td>
          <td class="ad2e-monster-buttons">
            <button type="button" data-action="rollAttack" data-key="{{a.key}}">{{localize "AD2E.Weapon.Attack"}}</button>
            <button type="button" data-action="rollDamage" data-key="{{a.key}}">{{localize "AD2E.Weapon.Damage"}}</button>
            {{#if @root.editable}}<a data-action="removeAttack" data-index="{{a.index}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </td>
        </tr>
        {{/each}}
        {{#each weapons as |w|}}
        <tr>
          <td><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{w.id}}">{{w.name}}</a></td>
          <td class="ad2e-weapon-meta">{{w.summary}}</td>
          <td class="ad2e-num">{{w.hit}}</td>
          <td data-tooltip="{{localize 'AD2E.Weapon.ElementHint'}}">{{w.element}}</td>
          <td>{{w.poison}}</td>
          <td>{{w.type}}</td>
          <td class="ad2e-monster-buttons">
            <button type="button" data-action="rollAttack" data-key="{{w.key}}">{{localize "AD2E.Weapon.Attack"}}</button>
            <button type="button" data-action="rollDamage" data-key="{{w.key}}">{{localize "AD2E.Weapon.Damage"}}</button>
          </td>
        </tr>
        {{/each}}
        <tr>
          <td><i class="fa-solid fa-hand-fist fa-fw" aria-hidden="true"></i> {{localize "AD2E.Unarmed.Title"}}</td>
          <td class="ad2e-weapon-meta" colspan="5">{{localize "AD2E.Unarmed.Meta"}}</td>
          <td class="ad2e-monster-buttons">
            <button type="button" data-action="rollUnarmed" data-form="punch">{{localize "AD2E.Unarmed.punch"}}</button>
            <button type="button" data-action="rollUnarmed" data-form="wrestle">{{localize "AD2E.Unarmed.wrestle"}}</button>
            <button type="button" data-action="rollUnarmed" data-form="overbear">{{localize "AD2E.Unarmed.overbear"}}</button>
          </td>
        </tr>
      </tbody>
    </table>
    {{#unless hasAttacks}}<p class="ad2e-placeholder">{{localize "AD2E.Monster.NoAttacks"}}</p>{{/unless}}
    {{#if editable}}<button type="button" data-action="addAttack"><i class="fa-solid fa-plus"></i> {{localize "AD2E.Monster.AddAttack"}}</button>{{/if}}
  </fieldset>
</section>
