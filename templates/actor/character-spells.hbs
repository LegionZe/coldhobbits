<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with spellTab as |st|}}
  <div class="ad2e-prof-summary">
    {{#if st.kind}}<span>{{localize "AD2E.Spell.Caster"}}: <strong>{{st.kind}}</strong></span>
    <span>{{localize "AD2E.Spell.CastingLevel"}}: <strong>{{st.castingLevel}}</strong></span>
    {{else}}<span class="ad2e-placeholder">{{localize "AD2E.Spell.NoCaster"}}</span>{{/if}}
    {{#if @root.editable}}<button type="button" data-action="restSpells" data-tooltip="{{localize 'AD2E.Spell.RestHint'}}"><i class="fa-solid fa-bed"></i> {{localize "AD2E.Spell.Rest"}}</button>{{/if}}
  </div>
  {{#if st.gen}}
  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Shair.Legend"}}</legend>
    <div class="ad2e-prof-summary">
      <label>{{localize "AD2E.Shair.GenKind"}}
        <select name="system.gen.kind" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions st.gen.kinds selected=st.gen.kind blank="—" localize=true}}</select></label>
      <label data-tooltip="{{localize 'AD2E.Shair.ReplacementsHint'}}">{{localize "AD2E.Shair.Replacements"}}
        <input type="number" name="system.gen.replacements" value="{{st.gen.replacements}}" min="0" {{#unless @root.editable}}disabled{{/unless}}></label>
      <span>{{st.gen.status}}</span>
      {{#if st.gen.isGM}}{{#if st.gen.busy}}<button type="button" data-action="genReturnNow" data-tooltip="{{localize 'AD2E.Shair.ReturnNowHint'}}">{{localize "AD2E.Shair.ReturnNow"}}</button>{{/if}}{{/if}}
    </div>
    {{#if st.gen.actor}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{st.gen.actor.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{st.gen.actor.uuid}}">{{st.gen.actor.name}}</a></span>
        <span class="ad2e-weapon-meta {{#if st.gen.actor.dead}}ad2e-unmet{{/if}}">{{st.gen.actor.meta}}{{#if st.gen.actor.dead}} · {{localize "AD2E.Gen.Dead"}}{{/if}}</span>
      </div>
      {{#if @root.editable}}<a data-action="dismissGen" data-tooltip="{{localize 'AD2E.Gen.Dismiss'}}"><i class="fa-solid fa-person-walking-arrow-right"></i></a>{{else}}<span></span>{{/if}}
    </div>
    {{else}}{{#if st.gen.missing}}<p class="ad2e-placeholder ad2e-unmet">{{localize "AD2E.Gen.Missing"}}</p>{{/if}}{{/if}}
    <div class="ad2e-prof-summary">
      <label data-tooltip="{{localize 'AD2E.Gen.NearHint'}}"><input type="checkbox" name="system.gen.near" {{checked st.gen.near}} {{#unless @root.editable}}disabled{{/unless}}> {{localize "AD2E.Gen.Near"}}</label>
      {{#if @root.editable}}{{#if st.gen.canSummon}}<button type="button" data-action="summonGen">{{localize "AD2E.Gen.Summon"}}</button>{{/if}}{{/if}}
      {{#if st.gen.needsDeath}}<button type="button" data-action="genDeath" class="ad2e-unmet">{{localize "AD2E.Gen.DeathButton"}}</button>{{/if}}
    </div>
    <p class="ad2e-note">{{localize "AD2E.Shair.Note"}}</p>
  </fieldset>
  {{else}}
  <p class="ad2e-note">{{localize "AD2E.Spell.DragHint"}}</p>
  {{/if}}
  {{#each st.levels as |l|}}
  <fieldset class="ad2e-prof-list ad2e-spell-level">
    <legend>{{l.label}}</legend>
    {{#unless st.shair}}
    <div class="ad2e-prof-summary">
      <span class="{{#if l.over}}ad2e-unmet{{/if}}">{{localize "AD2E.Spell.Memorized"}}: <strong>{{l.prepared}} / {{l.slots}}</strong>{{#if l.slotText}} <span class="ad2e-note">({{l.slotText}})</span>{{/if}}</span>
      <span>{{localize "AD2E.Spell.Remaining2"}}: <strong>{{l.remaining}}</strong></span>
      {{#if l.maxKnown}}<span data-tooltip="{{localize 'AD2E.Spell.KnownHint'}}">{{localize "AD2E.Spell.Known"}}: <strong>{{l.known}} / {{l.maxKnown}}</strong></span>{{/if}}
    </div>
    {{/unless}}
    {{#each l.rows as |r|}}
    <div class="ad2e-prof-row ad2e-spell-row {{#unless r.usable}}ad2e-spell-unusable{{/unless}}">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}{{#if r.reversible}} <em>(R)</em>{{/if}}</a>
        <span class="ad2e-weapon-meta">{{r.meta}}{{#unless r.usable}} · <span class="ad2e-unmet">{{localize "AD2E.Spell.NotForClass"}}</span>{{/unless}}</span>
        {{#if r.unlearned}}<span class="ad2e-weapon-meta ad2e-unmet">{{localize "AD2E.Learn.NotLearned"}} · {{r.learnText}}</span>{{/if}}
      </div>
      {{#if r.unlearned}}<button type="button" data-action="learnSpell" data-item-id="{{r.id}}" {{#if r.learnBlocked}}disabled{{/if}}>{{localize "AD2E.Learn.Learn"}}</button>{{/if}}
      {{#if r.request}}
      <button type="button" data-action="requestSpell" data-item-id="{{r.id}}" data-tooltip="{{r.request.hint}}" {{#if st.gen.busy}}disabled{{/if}}>{{localize "AD2E.Shair.Request"}} {{r.request.chance}}%</button>
      {{else}}
      <span class="ad2e-qty" data-tooltip="{{localize 'AD2E.Spell.MemorizedHint'}}">
        {{#if @root.editable}}<a data-action="adjustPrepared" data-item-id="{{r.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
        {{r.remaining}}/{{r.prepared}}
        {{#if @root.editable}}<a data-action="adjustPrepared" data-item-id="{{r.id}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </span>
      {{/if}}
      <button type="button" data-action="castSpell" data-item-id="{{r.id}}" {{#unless r.remaining}}disabled{{/unless}}>{{localize "AD2E.Spell.Cast"}}</button>
      {{#if r.damage}}<button type="button" data-action="rollSpellDamage" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Spell.DamageHint'}}"><i class="fa-solid fa-burst"></i></button>{{/if}}
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Spell.NoneAtLevel"}}</p>
    {{/each}}
  </fieldset>
  {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Spell.NoneYet"}}</p>
  {{/each}}
  {{/with}}
</section>
