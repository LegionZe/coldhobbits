<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="ad2e-columns">
    <fieldset class="ad2e-abilities">
      <legend>{{localize "AD2E.Character.abilities"}}</legend>
      {{#each abilities as |ab|}}
      <div class="ad2e-ability">
        <a data-action="rollAbility" data-ability="{{ab.key}}" data-tooltip="{{localize 'AD2E.Roll.Check'}}">{{ab.label}}</a>
        <input type="number" name="system.abilities.{{ab.key}}.value" value="{{ab.value}}" data-tooltip="{{localize 'AD2E.Race.RolledScore'}}">
        <strong class="ad2e-total {{#if ab.adjusted}}ad2e-adjusted{{/if}}" data-tooltip="{{localize 'AD2E.Race.EffectiveScore'}}">{{ab.total}}</strong>
        {{#if ab.isStr}}
        <input type="number" name="system.abilities.str.exceptional" value="{{ab.exceptional}}" data-tooltip="{{localize 'AD2E.Character.exceptional'}}" min="0" max="100">
        {{else}}<span></span>{{/if}}
      </div>
      {{/each}}
    </fieldset>

    <fieldset class="ad2e-combat">
      <legend>{{localize "AD2E.Character.combat"}}</legend>
      <div class="ad2e-field"><span>{{localize "AD2E.Character.hp"}}</span>
        <span class="ad2e-pair"><input type="number" name="system.hp.value" value="{{system.hp.value}}"> / <input type="number" name="system.hp.max" value="{{system.hp.max}}"></span></div>
      <div class="ad2e-field"><span>{{localize "AD2E.HP.HitDice"}}</span><strong>{{system.hitDice.label}}</strong></div>
      {{#if editable}}
      <div class="ad2e-buttons">
        <button type="button" data-action="rollFirstLevelHp">{{localize "AD2E.HP.RollFirst"}}</button>
        <button type="button" data-action="levelUp">{{localize "AD2E.HP.LevelUp"}}</button>
      </div>
      {{/if}}
      <div class="ad2e-field"><span>{{localize "AD2E.Character.acBase"}}</span><input type="number" name="system.ac.base" value="{{system.ac.base}}"></div>
      <div class="ad2e-field"><span>{{localize "AD2E.Character.acTotal"}}</span><strong data-tooltip="{{localize 'AD2E.Armor.Rear'}} {{system.armor.rear}} · {{localize 'AD2E.Armor.VsMissiles'}} {{system.armor.missile}}">{{system.ac.total}}</strong></div>
      <div class="ad2e-field"><span>{{localize "AD2E.Character.thac0Override"}}</span><input type="number" name="system.thac0.override" value="{{system.thac0.override}}" placeholder="{{system.thac0.computed}}"></div>
      <div class="ad2e-field"><span>THAC0</span><strong>{{system.thac0.value}}</strong></div>
      <div class="ad2e-field"><span>{{localize "AD2E.Move.Movement"}}</span><strong class="{{#if system.encumbrance.info.overMax}}ad2e-unmet{{/if}}" data-tooltip="{{localize 'AD2E.Move.Hint'}}">{{moveLabel}}</strong></div>
      <div class="ad2e-field"><span>{{localize "AD2E.Character.initMod"}}</span><input type="number" name="system.initiative.mod" value="{{system.initiative.mod}}"></div>
      <div class="ad2e-field"><span>{{localize "AD2E.Character.dmgAdj"}}</span><strong>{{system.mods.dmg}}</strong></div>
      <div class="ad2e-field"><span>{{localize "AD2E.Character.conHp"}}</span><strong>{{system.mods.conHp}}/HD</strong></div>
      <div class="ad2e-buttons">
        <button type="button" data-action="rollAttack" data-missile="false">{{localize "AD2E.Roll.Melee"}} ({{system.mods.meleeAttack}})</button>
        <button type="button" data-action="rollAttack" data-missile="true">{{localize "AD2E.Roll.Missile"}} ({{system.mods.missileAttack}})</button>
      </div>
    </fieldset>

    <fieldset class="ad2e-saves">
      <legend>{{localize "AD2E.Character.saves"}}</legend>
      {{#each saves as |sv|}}
      <div class="ad2e-save">
        <a data-action="rollSave" data-save="{{sv.key}}">{{sv.label}}</a>
        <strong class="{{#if sv.overridden}}ad2e-overridden{{/if}}">{{sv.value}}</strong>
        <span class="ad2e-save-bonus">{{#if sv.bonus}}<span data-tooltip="{{localize 'AD2E.Save.RollBonus'}}">+{{sv.bonus}}</span>{{/if}}{{#if sv.poison}}<span data-tooltip="{{localize 'AD2E.Race.PoisonBonus'}}">+{{sv.poison}}&#x2620;</span>{{/if}}</span>
        <input type="number" name="system.saves.{{sv.key}}.override" value="{{sv.override}}" placeholder="{{sv.table}}" data-tooltip="{{localize 'AD2E.Save.OverrideHint'}}">
      </div>
      {{/each}}
    </fieldset>
  </div>
</section>
