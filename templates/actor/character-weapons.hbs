<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with weaponTab as |wt|}}
  <p class="ad2e-note">{{localize "AD2E.Weapon.DragHint"}}</p>
  {{#with wt.enc as |e|}}
  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Enc.Encumbrance"}} &amp; {{localize "AD2E.Move.Movement"}}</legend>
    <div class="ad2e-prof-summary">
      <span class="{{#if e.overMax}}ad2e-unmet{{/if}}">{{localize "AD2E.Enc.Load"}}: <strong>{{e.total}} / {{e.maxCarried}} lb</strong>{{#if e.magicArmor}} <span data-tooltip="{{localize 'AD2E.Enc.MagicArmorHint'}}">({{e.effective}} {{localize "AD2E.Enc.ForMovement"}})</span>{{/if}}</span>
      {{#if e.category}}<span>{{localize "AD2E.Enc.Category"}}: <strong>{{e.categoryLabel}}</strong></span>{{/if}}
      <span>{{localize "AD2E.Move.Movement"}}: <strong>{{e.rate}}</strong> / {{e.base}} ({{e.feet}} ft · {{e.yards}} yd {{localize "AD2E.Move.PerRound"}})</span>
      {{#if e.penaltyText}}<span class="ad2e-unmet">{{e.penaltyText}}</span>{{/if}}
    </div>
    <div class="ad2e-prof-summary">
      <span>{{localize "AD2E.Enc.Items"}}: {{e.itemWeight}} lb · {{localize "AD2E.Coin.Coins"}}: {{e.coinWeight}} lb · {{localize "AD2E.Enc.Clothing"}}: {{e.clothing}} lb</span>
      <label>{{localize "AD2E.Enc.Other"}} <input type="number" name="system.encumbrance.other" value="{{e.other}}" min="0" step="any" {{#unless @root.editable}}disabled{{/unless}}></label>
      <label>{{localize "AD2E.Move.Override"}} <input type="number" name="system.movement.override" value="{{e.override}}" placeholder="{{e.raceBase}}" min="0" {{#unless @root.editable}}disabled{{/unless}}></label>
    </div>
    {{#if e.thresholds}}<p class="ad2e-note">{{e.thresholds}}</p>{{/if}}
  </fieldset>
  {{/with}}
  <fieldset class="ad2e-prof-list ad2e-gear">
    <legend>{{localize "AD2E.Gear.Gear"}}</legend>
    {{#each wt.gear as |g|}}
    <h4 class="ad2e-gear-heading">{{g.label}}</h4>
    {{#each g.rows as |r|}}
    <div class="ad2e-prof-row ad2e-gear-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{r.id}}">{{r.name}}</a><a class="ad2e-item-link" data-action="openItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.Open'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{#if r.url}}<a class="ad2e-item-link" href="{{r.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}</span>
        <span class="ad2e-weapon-meta">{{r.summary}}{{#if r.total}} · {{localize "AD2E.Gear.Total"}} {{r.total}} lb{{/if}}</span>
      </div>
      <label class="ad2e-spec" data-tooltip="{{localize 'AD2E.Gear.CarriedHint'}}">
        <input type="checkbox" data-action="toggleCarried" data-item-id="{{r.id}}" {{checked r.carried}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.Gear.Carried"}}</label>
      <span class="ad2e-qty" data-tooltip="{{localize 'AD2E.Weapon.Quantity'}}">
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{r.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
        {{r.quantity}}
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{r.id}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{/each}}
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Gear.NoneYet"}}</p>
    {{/each}}
  </fieldset>
  <fieldset class="ad2e-prof-list ad2e-coins">
    <legend>{{localize "AD2E.Coin.Coins"}}</legend>
    {{#each wt.coins.list as |c|}}
    <div class="ad2e-prof-row ad2e-coin-row">
      <img src="{{c.img}}" alt="" width="24" height="24">
      <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{c.id}}">{{c.name}}</a><a class="ad2e-item-link" data-action="openItem" data-item-id="{{c.id}}" data-tooltip="{{localize 'AD2E.Item.Open'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{#if c.url}}<a class="ad2e-item-link" href="{{c.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}</span>
      <input type="number" data-coin-quantity data-item-id="{{c.id}}" value="{{c.quantity}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}} data-tooltip="{{localize 'AD2E.Weapon.Quantity'}}">
      <span class="ad2e-coin-value">{{c.value}} gp</span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{c.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Coin.NoneYet"}}</p>
    {{/each}}
    <p class="ad2e-note" data-tooltip="{{localize 'AD2E.Coin.Hint'}}">{{localize "AD2E.Coin.Total"}}: {{wt.coins.gp}} gp · {{wt.coins.count}} {{localize "AD2E.Coin.CoinsLower"}} = {{wt.coins.weight}} lb</p>
  </fieldset>
  <fieldset class="ad2e-prof-list ad2e-magic">
    <legend>{{localize "AD2E.Magic.Items"}}</legend>
    {{#each wt.magic as |m|}}
    <div class="ad2e-prof-row ad2e-gear-row">
      <img src="{{m.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{m.id}}">{{m.name}}</a><a class="ad2e-item-link" data-action="openItem" data-item-id="{{m.id}}" data-tooltip="{{localize 'AD2E.Item.Open'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{#if m.url}}<a class="ad2e-item-link" href="{{m.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}</span>
        <span class="ad2e-weapon-meta">{{m.summary}}</span>
      </div>
      <label class="ad2e-spec" data-tooltip="{{localize 'AD2E.Gear.CarriedHint'}}">
        <input type="checkbox" data-action="toggleCarried" data-item-id="{{m.id}}" {{checked m.carried}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.Gear.Carried"}}</label>
      <span class="ad2e-qty" data-tooltip="{{localize 'AD2E.Weapon.Quantity'}}">
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{m.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
        {{m.quantity}}
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{m.id}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </span>
      <button type="button" data-action="useMagicItem" data-item-id="{{m.id}}" {{#unless m.usable}}disabled{{/unless}} data-tooltip="{{localize 'AD2E.Magic.UseHint'}}">{{localize "AD2E.Magic.Use"}}</button>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{m.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Magic.NoneYet"}}</p>
    {{/each}}
  </fieldset>
  <fieldset class="ad2e-prof-list ad2e-treasure">
    <legend>{{localize "AD2E.Treasure.Treasure"}}</legend>
    {{#each wt.treasure.list as |t|}}
    <div class="ad2e-prof-row ad2e-gear-row">
      <img src="{{t.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{t.id}}">{{t.name}}</a><a class="ad2e-item-link" data-action="openItem" data-item-id="{{t.id}}" data-tooltip="{{localize 'AD2E.Item.Open'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{#if t.url}}<a class="ad2e-item-link" href="{{t.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}</span>
        <span class="ad2e-weapon-meta">{{t.summary}}{{#if t.total}} · {{localize "AD2E.Gear.Total"}} {{t.total}} gp{{/if}}</span>
      </div>
      <label class="ad2e-spec" data-tooltip="{{localize 'AD2E.Gear.CarriedHint'}}">
        <input type="checkbox" data-action="toggleCarried" data-item-id="{{t.id}}" {{checked t.carried}} {{#unless @root.editable}}disabled{{/unless}}>
        {{localize "AD2E.Gear.Carried"}}</label>
      <span class="ad2e-qty" data-tooltip="{{localize 'AD2E.Weapon.Quantity'}}">
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{t.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
        {{t.quantity}}
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{t.id}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{t.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Treasure.NoneYet"}}</p>
    {{/each}}
    <p class="ad2e-note">{{localize "AD2E.Treasure.Total"}}: {{wt.treasure.gp}} gp · {{localize "AD2E.Treasure.Wealth"}}: {{wt.treasure.wealth}} gp</p>
  </fieldset>
  {{> "ad2e.armor-list" wt=wt armor=wt.armor}}

  {{> "ad2e.weapon-list" wt=wt rows=wt.rows}}

  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Ammo.Ammunition"}}</legend>
    {{#each wt.ammo as |a|}}
    <div class="ad2e-prof-row ad2e-ammo-row">
      <img src="{{a.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{a.id}}">{{a.name}}{{#if a.bonus}} {{a.bonus}}{{/if}}</a><a class="ad2e-item-link" data-action="openItem" data-item-id="{{a.id}}" data-tooltip="{{localize 'AD2E.Item.Open'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{#if a.url}}<a class="ad2e-item-link" href="{{a.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}</span>
        <span class="ad2e-weapon-meta">{{localize "AD2E.Weapon.Damage"}} {{a.damage}} · {{localize "AD2E.Ammo.Launchers"}}: {{a.launchers}}</span>
      </div>
      <span class="ad2e-qty {{#if a.empty}}ad2e-unmet{{/if}}" data-tooltip="{{localize 'AD2E.Weapon.Quantity'}}">
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{a.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
        {{a.quantity}}
        {{#if @root.editable}}<a data-action="adjustQuantity" data-item-id="{{a.id}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </span>
      {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{a.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Ammo.NoneYet"}}</p>
    {{/each}}
  </fieldset>
  {{/with}}
</section>
