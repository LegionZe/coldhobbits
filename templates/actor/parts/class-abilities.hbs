{{!-- Class abilities (skills, backstab, turning, paladin powers): ft = featureTab (Class Abilities and Combat tabs). --}}
{{!-- ft.combat (Combat tab): values as text, no form inputs (duplicate input names break the sheet form). --}}
{{!-- Re-bind ft as a block parameter: hash values are not visible inside nested {{#each}} blocks. --}}
{{#with ft as |ft|}}
{{#unless ft.classItem}}<p class="ad2e-placeholder">{{localize "AD2E.Ability2.None"}}</p>{{/unless}}

{{#if ft.hasSkills}}
<fieldset class="ad2e-skills">
  <legend>{{ft.skillTitle}}</legend>
  {{#if ft.budget}}
  <div class="ad2e-prof-summary">
    <span class="{{#if ft.budgetOver}}ad2e-unmet{{/if}}" data-tooltip="{{localize 'AD2E.Skill.BudgetHint'}}">{{ft.budget}}</span>
    {{#if ft.perSkillMax}}<span>{{ft.perSkillMax}}</span>{{/if}}
  </div>
  {{/if}}
  {{#if ft.armorBlocked}}<p class="ad2e-unmet">{{localize "AD2E.Skill.HeavyArmor"}}</p>{{/if}}
  <table class="ad2e-race-table ad2e-skill-table">
    <thead><tr><th></th><th>{{localize "AD2E.Skill.Base"}}</th><th>{{localize "AD2E.Skill.Race"}}</th><th>{{localize "AD2E.Skill.Dex"}}</th>
      {{#if ft.showArmor}}<th>{{localize "AD2E.Skill.Armor"}}</th>{{/if}}<th>{{localize "AD2E.Skill.Kit"}}</th>
      {{#if ft.showPoints}}<th>{{localize "AD2E.Skill.Points"}}</th>{{/if}}<th>{{localize "AD2E.Skill.Total"}}</th><th></th></tr></thead>
    <tbody>
      {{#each ft.skills as |s|}}
      <tr class="{{#unless s.available}}ad2e-unmet{{/unless}}">
        <th>{{s.label}}</th><td>{{s.base}}%</td><td>{{s.raceText}}</td><td>{{s.dexText}}</td>
        {{#if ft.showArmor}}<td>{{s.armorText}}</td>{{/if}}<td>{{s.kitText}}</td>
        {{#if ft.showPoints}}<td>{{#if ft.combat}}{{s.points}}{{else}}<input type="number" name="system.classAbilities.points.{{s.key}}" value="{{s.points}}" min="0" max="95" step="1"
          class="{{#if s.overLimit}}ad2e-unmet{{/if}}" {{#unless @root.editable}}disabled{{/unless}}>{{/if}}</td>{{/if}}
        <td><strong>{{s.total}}%</strong>{{#if s.capped}} <span data-tooltip="{{localize 'AD2E.Skill.Cap'}}">*</span>{{/if}}</td>
        <td><button type="button" data-action="rollClassSkill" data-skill="{{s.key}}" {{#unless s.available}}disabled{{/unless}}>{{localize "AD2E.Skill.Roll"}}</button></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if ft.cap}}<p class="ad2e-note">{{localize "AD2E.Skill.Cap"}}</p>{{/if}}
  {{#if ft.trapNote}}<p class="ad2e-note">{{localize "AD2E.Skill.TrapNote"}}</p>{{/if}}
  {{#if ft.ranger}}<p class="ad2e-note">{{localize "AD2E.Skill.RangerNote"}}</p>{{/if}}
</fieldset>
{{/if}}

{{#if ft.backstab}}
<fieldset><legend>{{localize "AD2E.Ability2.Backstab"}}</legend><p>{{ft.backstab}}</p></fieldset>
{{/if}}
{{#if ft.turnLevel}}
<fieldset>
  <legend>{{localize "AD2E.Ability2.TurnUndead"}}</legend>
  <div class="ad2e-prof-summary">
    <span>{{ft.turnLevel}}</span>
    <button type="button" data-action="rollTurnUndead"><i class="fa-solid fa-cross"></i> {{localize "AD2E.Ability2.TurnUndead"}}</button>
  </div>
  <p class="ad2e-note">{{localize "AD2E.Ability2.TurnHint"}}</p>
</fieldset>
{{/if}}
{{#if ft.layOnHands}}
<fieldset>
  <legend>{{localize "AD2E.Ability2.LayOnHands"}}</legend>
  <div class="ad2e-prof-summary">
    <span>{{ft.layOnHands.text}}</span>
    <button type="button" data-action="layOnHands" {{#if ft.layOnHands.used}}disabled data-tooltip="{{localize 'AD2E.Ability2.LayOnHandsUsed'}}"{{/if}}><i class="fa-solid fa-hand-holding-medical"></i> {{localize "AD2E.Ability2.LayOnHands"}}</button>
    {{#if @root.editable}}<button type="button" data-action="restSpells"><i class="fa-solid fa-bed"></i> {{localize "AD2E.Ability2.Rest"}}</button>{{/if}}
  </div>
  <p>{{ft.cureDisease}}</p>
</fieldset>
{{/if}}
{{#if ft.speciesEnemy}}
<fieldset>
  <legend>{{localize "AD2E.Ability2.SpeciesEnemy"}}</legend>
  {{#if ft.combat}}<strong>{{@root.system.classAbilities.speciesEnemy}}</strong>{{else}}<input type="text" name="system.classAbilities.speciesEnemy" value="{{@root.system.classAbilities.speciesEnemy}}" {{#unless @root.editable}}disabled{{/unless}}>{{/if}}
  <p>{{ft.tracking}}</p>
</fieldset>
{{/if}}

{{#if ft.features.length}}
<fieldset class="ad2e-features">
  <legend>{{localize "AD2E.Ability2.Features"}}</legend>
  <dl class="ad2e-facts">
    {{#each ft.features as |f|}}
    <dt class="{{#unless f.gained}}ad2e-placeholder{{/unless}}">{{f.name}} <span class="ad2e-note">({{f.level}})</span></dt>
    <dd class="{{#unless f.gained}}ad2e-placeholder{{/unless}}">{{f.text}}</dd>
    {{/each}}
  </dl>
  {{#if ft.classItem.system.url}}<p><a href="{{ft.classItem.system.url}}" target="_blank" rel="noopener">{{ft.classItem.name}} <i class="fa-solid fa-arrow-up-right-from-square"></i></a></p>{{/if}}
</fieldset>
{{/if}}

{{#if ft.kitItem}}
<fieldset>
  <legend>{{localize "AD2E.Ability2.KitAbilities"}}</legend>
  <p>{{localize "AD2E.Ability2.KitText"}} {{#if ft.kitItem.system.url}}<a href="{{ft.kitItem.system.url}}" target="_blank" rel="noopener">{{ft.kitItem.name}} <i class="fa-solid fa-arrow-up-right-from-square"></i></a>{{else}}{{ft.kitItem.name}}{{/if}}</p>
  {{#if ft.kitAdjust}}<p>{{localize "AD2E.Skill.KitAdjust"}}: {{ft.kitAdjust}}</p>{{/if}}
  {{#if ft.kitPoints}}<p>{{ft.kitPoints}}</p>{{/if}}
  {{#if ft.kitMods.length}}
  <p class="ad2e-note">{{localize "AD2E.Kit.ModifiersHint"}}</p>
  <ul class="ad2e-kit-mods">
    {{#each ft.kitMods as |m|}}<li class="ad2e-kit-mod-{{m.status}}"><span class="ad2e-kit-status">{{m.statusLabel}}</span> {{m.text}}</li>{{/each}}
  </ul>
  {{/if}}
</fieldset>
{{/if}}
{{/with}}
