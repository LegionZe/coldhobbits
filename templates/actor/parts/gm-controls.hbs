{{!-- GM section (Character tab, 1.0.47; owner's ruling: players never see GM controls). Rendered only for the GM (`gm`). The
     construction start/stop and the gen's "return now" stay beside their panels (GM only there too). --}}
{{#with gm as |g|}}
<fieldset class="ad2e-prof-list ad2e-gm-section">
  <legend><i class="fa-solid fa-user-shield"></i> {{localize "AD2E.Sheet.GmSection"}}</legend>
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{localize "AD2E.Drain.Title"}}</span>
    <button type="button" data-action="drainLevels" data-tooltip="{{localize 'AD2E.Drain.Hint'}}"><i class="fa-solid fa-skull"></i> {{localize "AD2E.Drain.Title"}}</button>
    {{#if @root.drain.any}}<button type="button" data-action="restoreLevel" data-tooltip="{{localize 'AD2E.Drain.RestoreHint'}}"><i class="fa-solid fa-sun"></i> {{localize "AD2E.Drain.Restore"}}</button>{{/if}}
  </div>
  {{#if g.dual}}
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{localize "AD2E.Dual.Legend"}}</span>
    <button type="button" data-action="clearDualPenalty" data-kind="encounter" {{#unless g.dual.encounter}}disabled{{/unless}}>{{localize "AD2E.Dual.ClearEncounter"}}</button>
    <button type="button" data-action="clearDualPenalty" data-kind="all" {{#unless g.dual.adventure}}disabled{{/unless}}>{{localize "AD2E.Dual.EndAdventure"}}</button>
    <button type="button" data-action="undoDualClass" data-tooltip="{{localize 'AD2E.Dual.UndoHint'}}"><i class="fa-solid fa-rotate-left"></i> {{localize "AD2E.Dual.Undo"}}</button>
  </div>
  {{/if}}
  {{#if g.familiar}}
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{localize "AD2E.Familiar.Title"}}</span>
    <button type="button" data-action="findFamiliar" data-tooltip="{{localize 'AD2E.Familiar.FindHint'}}">{{localize "AD2E.Familiar.Find"}}</button>
  </div>
  {{/if}}
  {{#with g.bond as |b|}}
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{#if b.isCompanion}}{{localize "AD2E.Bond.Title.companion"}}{{else}}{{localize "AD2E.Bond.Title.mount"}}{{/if}}</span>
    <button type="button" data-action="bondRoll" data-tooltip="{{localize 'AD2E.Bond.RollHint'}}"><i class="fa-solid fa-dice"></i> {{#if b.isCompanion}}{{localize "AD2E.Bond.CompanionTable"}}{{else}}{{localize "AD2E.Bond.MountTable"}}{{/if}}</button>
    {{#if b.current.actor}}{{#if b.isCompanion}}
    <button type="button" data-action="companionLost" data-careless="false">{{localize "AD2E.Bond.LostNatural"}}</button>
    <button type="button" data-action="companionLost" data-careless="true">{{localize "AD2E.Bond.LostCareless"}}</button>
    {{else}}
    <button type="button" data-action="mountDied">{{localize "AD2E.Bond.MountDiedTitle"}}</button>
    <button type="button" data-action="mountFled">{{localize "AD2E.Bond.FledTitle"}}</button>
    {{/if}}{{/if}}
    {{#if b.feeble}}<button type="button" data-action="endFeeblemind">{{localize "AD2E.Bond.FeebleEnd"}}</button>{{/if}}
  </div>
  {{/with}}
  {{#each g.followers as |s|}}
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{localize "AD2E.Followers.Title"}}</span>
    <span>{{s.label}}</span>
    <button type="button" data-action="attractFollowers" data-class="{{s.id}}"><i class="fa-solid fa-flag"></i> {{localize "AD2E.Followers.Attract"}}</button>
  </div>
  {{/each}}
  {{#with g.station as |s|}}{{#if s.isGM}}
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{localize "AD2E.Station.Label"}}</span>
    <label>{{localize "AD2E.Station.Initial"}} <input type="number" name="system.station.base" value="{{@root.system.station.base}}" min="0" max="20" step="1" placeholder="—"></label>
    <button type="button" data-action="stationConvict">{{#if s.criminal}}{{localize "AD2E.Station.Pardon"}}{{else}}{{localize "AD2E.Station.Convict"}}{{/if}}</button>
    <button type="button" data-action="stationPenniless">{{#if s.penniless}}{{localize "AD2E.Station.NotPenniless"}}{{else}}{{localize "AD2E.Station.Penniless"}}{{/if}}</button>
    {{#if s.penniless}}<label data-tooltip="{{localize 'AD2E.Station.DebtsHint' gp=s.pennilessGp}}"><input type="checkbox" name="system.station.debts" {{#if s.debts}}checked{{/if}}> {{localize "AD2E.Station.Debts"}}</label>{{/if}}
    <button type="button" data-action="stationEnslave">{{#if s.slave}}{{localize "AD2E.Station.Free"}}{{else}}{{localize "AD2E.Station.Enslave"}}{{/if}}</button>
  </div>
  {{/if}}{{/with}}
  {{#with g.aging as |a|}}
  <div class="ad2e-prof-summary">
    <span class="ad2e-header-label">{{localize "AD2E.Character.age"}}</span>
    <label data-tooltip="{{localize 'AD2E.Aging.MaxHint'}}">{{localize "AD2E.Aging.MaxAge"}} <input type="number" name="system.maxAge" value="{{@root.system.maxAge}}" min="0" step="1" placeholder="—"></label>
    {{#if a.maxFormula}}<button type="button" data-action="rollMaxAge" data-tooltip="{{a.maxFormula}}"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Aging.RollMax"}}</button>{{/if}}
  </div>
  {{/with}}
</fieldset>
{{/with}}
