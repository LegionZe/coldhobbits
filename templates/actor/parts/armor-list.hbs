{{!-- Armour list and Armor Class summary: wt = weaponTab, armor = rows (Combat tab rows have `combat`: no tick box); combat = Combat tab (no form inputs:
     a second input with the same name makes the sheet submit an array, which fails validation). --}}
<fieldset class="ad2e-prof-list">
  <legend>{{localize "AD2E.Armor.Armour"}}</legend>
  <div class="ad2e-prof-summary">
    <span>{{localize "AD2E.Character.acTotal"}}: <strong>{{wt.ac.front}}</strong></span>
    <span data-tooltip="{{localize 'AD2E.Armor.RearHint'}}">{{localize "AD2E.Armor.Rear"}}: <strong>{{wt.ac.rear}}</strong></span>
    {{#if wt.ac.missileDiffers}}<span>{{localize "AD2E.Armor.VsMissiles"}}: <strong>{{wt.ac.missile}}</strong></span>{{/if}}
    <span>{{wt.ac.source}}{{#if wt.ac.shield}} + {{wt.ac.shield}}{{/if}}</span>
    {{#if combat}}{{#if @root.system.ac.misc}}<span data-tooltip="{{localize 'AD2E.Armor.MiscHint'}}">{{localize "AD2E.Armor.Misc"}}: <strong>{{@root.system.ac.misc}}</strong></span>{{/if}}
    {{else}}<label data-tooltip="{{localize 'AD2E.Armor.MiscHint'}}">{{localize "AD2E.Armor.Misc"}} <input type="number" name="system.ac.misc" value="{{@root.system.ac.misc}}" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>{{/if}}
  </div>
  {{#each armor as |a|}}
  <div class="ad2e-prof-row ad2e-armor-row draggable" data-item-id="{{a.id}}">
    <img src="{{a.img}}" alt="" width="24" height="24">
    <div class="ad2e-weapon-main">
      <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openItem" data-item-id="{{a.id}}">{{a.name}}</a><a class="ad2e-item-link" data-action="openItem" data-item-id="{{a.id}}" data-tooltip="{{localize 'AD2E.Item.Open'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{#if a.url}}<a class="ad2e-item-link" href="{{a.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}"><i class="fa-solid fa-book-open"></i></a>{{/if}}</span>
      <span class="ad2e-weapon-meta">{{a.summary}}{{#if a.meta}} · {{a.meta}}{{/if}}{{#if a.inside}} · {{a.inside}}{{/if}}</span>
      {{#if a.warning}}<span class="ad2e-weapon-meta ad2e-unmet">{{a.warning}}</span>{{/if}}
    </div>
    {{#unless a.combat}}<label class="ad2e-spec {{#if a.unused}}ad2e-unmet{{/if}}" {{#if a.unused}}data-tooltip="{{localize 'AD2E.Armor.Unused'}}"{{/if}}>
      <input type="checkbox" data-action="toggleEquipped" data-item-id="{{a.id}}" {{checked a.equipped}} {{#unless @root.editable}}disabled{{/unless}}>
      {{localize "AD2E.Armor.Equipped"}}</label>
    {{#if @root.editable}}<a data-action="deleteItem" data-item-id="{{a.id}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}{{/unless}}
  </div>
  {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Armor.NoneYet"}}</p>
  {{/each}}
</fieldset>
