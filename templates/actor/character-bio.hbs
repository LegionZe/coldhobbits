<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with familiar as |f|}}
  <fieldset class="ad2e-prof-list ad2e-familiar">
    <legend>{{localize "AD2E.Familiar.Title"}}</legend>
    <p class="ad2e-note">{{f.rule}}</p>
    {{#if f.actor}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{f.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{f.uuid}}">{{f.name}}</a></span>
        <span class="ad2e-weapon-meta {{#if f.dead}}ad2e-unmet{{/if}}">{{f.meta}}{{#if f.dead}} · {{localize "AD2E.Familiar.Dead"}}{{/if}}</span>
      </div>
      {{#if @root.editable}}<a data-action="removeFamiliar" data-tooltip="{{localize 'AD2E.Familiar.Remove'}}"><i class="fa-solid fa-trash"></i></a>{{else}}<span></span>{{/if}}
    </div>
    <div class="ad2e-prof-summary">
      <label data-tooltip="{{localize 'AD2E.Familiar.NearHint'}}"><input type="checkbox" name="system.familiar.near" {{checked f.near}} {{#unless @root.editable}}disabled{{/unless}}> {{localize "AD2E.Familiar.Near"}}</label>
      <label data-tooltip="{{localize 'AD2E.Familiar.SeparatedHint'}}"><input type="checkbox" name="system.familiar.separated" {{checked f.separated}} {{#unless @root.editable}}disabled{{/unless}}> {{localize "AD2E.Familiar.Separated"}}</label>
      {{#if f.needsDeathRoll}}<button type="button" data-action="familiarDeath" class="ad2e-unmet">{{localize "AD2E.Familiar.DeathButton"}}</button>{{/if}}
    </div>
    {{else}}
    {{#if f.missing}}<p class="ad2e-placeholder ad2e-unmet">{{localize "AD2E.Familiar.Missing"}} {{#if @root.editable}}<a data-action="removeFamiliar"><i class="fa-solid fa-trash"></i></a>{{/if}}</p>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Familiar.None"}}</p>{{/if}}
    {{/if}}
    <div class="ad2e-prof-summary">
      <span class="{{#if f.tooSoon}}ad2e-unmet{{/if}}">{{f.attemptText}}</span>
      {{#if f.isGM}}<button type="button" data-action="findFamiliar" data-tooltip="{{localize 'AD2E.Familiar.FindHint'}}">{{localize "AD2E.Familiar.Find"}}</button>{{/if}}
    </div>
  </fieldset>
  {{/with}}
  {{#with bond as |b|}}
  <fieldset class="ad2e-prof-list ad2e-bond">
    <legend>{{#if b.isCompanion}}{{localize "AD2E.Bond.Title.companion"}}{{else}}{{localize "AD2E.Bond.Title.mount"}}{{/if}}</legend>
    {{#if b.rule}}<p class="ad2e-note">{{b.rule}}</p>{{/if}}
    {{#if b.kind}}
    {{#if b.current.actor}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{b.current.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{b.current.uuid}}">{{b.current.name}}</a></span>
        <span class="ad2e-weapon-meta {{#if b.current.dead}}ad2e-unmet{{/if}}">{{b.current.meta}}</span>
        {{#if b.current.oversize}}<span class="ad2e-weapon-meta ad2e-unmet">{{localize "AD2E.Bond.OversizeShort"}}</span>{{/if}}
        {{#each b.current.fit as |w|}}<span class="ad2e-weapon-meta ad2e-unmet">{{w}}</span>{{/each}}
      </div>
      {{#if @root.editable}}<a data-action="bondClear" data-tooltip="{{localize 'AD2E.Bond.Clear'}}"><i class="fa-solid fa-link-slash"></i></a>{{else}}<span></span>{{/if}}
    </div>
    {{else}}
    <p class="ad2e-placeholder">{{localize "AD2E.Bond.None"}}</p>
    {{#if b.candidates.length}}{{#if @root.editable}}<div class="ad2e-prof-summary"><select data-bond-candidate>{{#each b.candidates as |c|}}<option value="{{c.uuid}}">{{c.name}}</option>{{/each}}</select>
      <button type="button" data-action="bondSet">{{localize "AD2E.Bond.Set"}}</button></div>{{/if}}{{/if}}
    {{/if}}
    {{#if b.barredText}}<p class="ad2e-note">{{localize "AD2E.Bond.Barred"}}: {{b.barredText}}</p>{{/if}}
    {{#if b.rapportLost}}<p class="ad2e-unmet">{{localize "AD2E.Bond.RapportLost"}}</p>{{/if}}
    {{#if b.feeble}}<p class="ad2e-unmet">{{b.feeble}}{{#if b.isGM}} <button type="button" data-action="endFeeblemind">{{localize "AD2E.Bond.FeebleEnd"}}</button>{{/if}}</p>{{/if}}
    {{#if b.isGM}}<div class="ad2e-prof-summary">
      <button type="button" data-action="bondRoll" data-tooltip="{{localize 'AD2E.Bond.RollHint'}}"><i class="fa-solid fa-dice"></i> {{#if b.isCompanion}}{{localize "AD2E.Bond.CompanionTable"}}{{else}}{{localize "AD2E.Bond.MountTable"}}{{/if}}</button>
      {{#if b.current.actor}}{{#if b.isCompanion}}
      <button type="button" data-action="companionLost" data-careless="false">{{localize "AD2E.Bond.LostNatural"}}</button>
      <button type="button" data-action="companionLost" data-careless="true">{{localize "AD2E.Bond.LostCareless"}}</button>
      {{else}}
      <button type="button" data-action="mountDied">{{localize "AD2E.Bond.MountDiedTitle"}}</button>
      <button type="button" data-action="mountFled">{{localize "AD2E.Bond.FledTitle"}}</button>
      {{/if}}{{/if}}
    </div>{{/if}}
    {{/if}}
  </fieldset>
  {{/with}}
  {{#with henchmen as |h|}}
  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Henchmen.Title"}}</legend>
    <div class="ad2e-prof-summary">
      <span class="{{#if h.over}}ad2e-unmet{{/if}}" data-tooltip="{{localize 'AD2E.Henchmen.LifetimeHint'}}">{{localize "AD2E.Henchmen.Lifetime"}}: <strong>{{h.lifetime}} / {{h.max}}</strong></span>
      <label data-tooltip="{{localize 'AD2E.Henchmen.LostHint'}}">{{localize "AD2E.Henchmen.Lost"}} <input type="number" name="system.henchmen.lost" value="{{h.lost}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>
      <span data-tooltip="{{localize 'AD2E.Henchmen.LoyaltyHint'}}">{{localize "AD2E.Henchmen.Loyalty"}}: <strong>{{h.loyaltyText}}</strong></span>
      <span>{{localize "AD2E.Henchmen.Morale"}}: <strong>{{h.morale}}</strong></span>
    </div>
    {{#each h.rows as |r|}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{r.uuid}}">{{r.name}}</a></span>
        <span class="ad2e-weapon-meta">{{r.detail}}</span>
        {{#if r.tooHigh}}<span class="ad2e-weapon-meta ad2e-unmet">{{localize "AD2E.Henchmen.TooHigh"}}</span>{{/if}}
      </div>
      <button type="button" data-action="henchmanMorale" data-uuid="{{r.uuid}}">{{localize "AD2E.Monster.Morale"}}</button>
      {{#if @root.editable}}<a data-action="removeHenchman" data-uuid="{{r.uuid}}" data-tooltip="{{localize 'AD2E.Henchmen.Remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Henchmen.DropHint"}}</p>
    {{/each}}
  </fieldset>
  {{/with}}
  <div class="form-group ad2e-age"><label>{{localize "AD2E.Character.age"}}</label>
    <input type="number" name="system.age" value="{{system.age}}" min="0" step="1" placeholder="—"></div>
  <textarea class="ad2e-biography" name="system.biography">{{system.biography}}</textarea>
</section>
