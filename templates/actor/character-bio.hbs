<section class="tab ad2e-tab {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#with familiar as |f|}}
  <fieldset class="ad2e-prof-list ad2e-familiar">
    <legend>{{localize "AD2E.Familiar.Title"}}</legend>
    <p class="ad2e-note">{{f.rule}}</p>
    {{#if f.actor}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{f.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{f.uuid}}">{{f.name}}</a></span>
        <span class="ad2e-weapon-meta {{#if f.dead}}ad2e-unmet{{/if}}">{{f.meta}}{{#if f.dead}} · {{localize "AD2E.Familiar.Dead"}}{{/if}}</span>
      </div>
      {{#if @root.editable}}<a data-action="removeFamiliar" data-tooltip="{{localize 'AD2E.Familiar.Remove'}}"><i class="fa-solid fa-trash"></i></a>{{else}}<span></span>{{/if}}
    </div>
    <div class="ad2e-prof-summary">
      <label data-tooltip="{{localize 'AD2E.Familiar.NearHint'}}"><input type="checkbox" name="system.familiar.near" {{checked f.near}} {{#unless @root.editable}}disabled{{/unless}}> {{localize "AD2E.Familiar.Near"}}</label>
      <label data-tooltip="{{localize 'AD2E.Familiar.SeparatedHint'}}"><input type="checkbox" name="system.familiar.separated" {{checked f.separated}} {{#unless @root.editable}}disabled{{/unless}}> {{localize "AD2E.Familiar.Separated"}}</label>
      {{#if f.needsDeathRoll}}<button type="button" data-action="familiarDeath" class="ad2e-unmet">{{localize "AD2E.Familiar.DeathButton"}}</button>{{/if}}
    </div>
    {{else}}
    {{#if f.missing}}<p class="ad2e-placeholder ad2e-unmet">{{localize "AD2E.Familiar.Missing"}} {{#if @root.editable}}<a data-action="removeFamiliar"><i class="fa-solid fa-trash"></i></a>{{/if}}</p>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Familiar.None"}}</p>{{/if}}
    {{/if}}
    <div class="ad2e-prof-summary">
      <span class="{{#if f.tooSoon}}ad2e-unmet{{/if}}">{{f.attemptText}}</span>
      {{#if f.isGM}}<button type="button" data-action="findFamiliar" data-tooltip="{{localize 'AD2E.Familiar.FindHint'}}">{{localize "AD2E.Familiar.Find"}}</button>{{/if}}
    </div>
  </fieldset>
  {{/with}}
  {{#with bond as |b|}}
  <fieldset class="ad2e-prof-list ad2e-bond">
    <legend>{{#if b.isCompanion}}{{localize "AD2E.Bond.Title.companion"}}{{else}}{{localize "AD2E.Bond.Title.mount"}}{{/if}}</legend>
    {{#if b.rule}}<p class="ad2e-note">{{b.rule}}</p>{{/if}}
    {{#if b.kind}}
    {{#if b.current.actor}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{b.current.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{b.current.uuid}}">{{b.current.name}}</a></span>
        <span class="ad2e-weapon-meta {{#if b.current.dead}}ad2e-unmet{{/if}}">{{b.current.meta}}</span>
        {{#if b.current.oversize}}<span class="ad2e-weapon-meta ad2e-unmet">{{localize "AD2E.Bond.OversizeShort"}}</span>{{/if}}
        {{#each b.current.fit as |w|}}<span class="ad2e-weapon-meta ad2e-unmet">{{w}}</span>{{/each}}
      </div>
      {{#if @root.editable}}<a data-action="bondClear" data-tooltip="{{localize 'AD2E.Bond.Clear'}}"><i class="fa-solid fa-link-slash"></i></a>{{else}}<span></span>{{/if}}
    </div>
    {{else}}
    <p class="ad2e-placeholder">{{localize "AD2E.Bond.None"}}</p>
    {{#if b.candidates.length}}{{#if @root.editable}}<div class="ad2e-prof-summary"><select data-bond-candidate>{{#each b.candidates as |c|}}<option value="{{c.uuid}}">{{c.name}}</option>{{/each}}</select>
      <button type="button" data-action="bondSet">{{localize "AD2E.Bond.Set"}}</button></div>{{/if}}{{/if}}
    {{/if}}
    {{#if b.barredText}}<p class="ad2e-note">{{localize "AD2E.Bond.Barred"}}: {{b.barredText}}</p>{{/if}}
    {{#if b.rapportLost}}<p class="ad2e-unmet">{{localize "AD2E.Bond.RapportLost"}}</p>{{/if}}
    {{#if b.feeble}}<p class="ad2e-unmet">{{b.feeble}}{{#if b.isGM}} <button type="button" data-action="endFeeblemind">{{localize "AD2E.Bond.FeebleEnd"}}</button>{{/if}}</p>{{/if}}
    {{#if b.isGM}}<div class="ad2e-prof-summary">
      <button type="button" data-action="bondRoll" data-tooltip="{{localize 'AD2E.Bond.RollHint'}}"><i class="fa-solid fa-dice"></i> {{#if b.isCompanion}}{{localize "AD2E.Bond.CompanionTable"}}{{else}}{{localize "AD2E.Bond.MountTable"}}{{/if}}</button>
      {{#if b.current.actor}}{{#if b.isCompanion}}
      <button type="button" data-action="companionLost" data-careless="false">{{localize "AD2E.Bond.LostNatural"}}</button>
      <button type="button" data-action="companionLost" data-careless="true">{{localize "AD2E.Bond.LostCareless"}}</button>
      {{else}}
      <button type="button" data-action="mountDied">{{localize "AD2E.Bond.MountDiedTitle"}}</button>
      <button type="button" data-action="mountFled">{{localize "AD2E.Bond.FledTitle"}}</button>
      {{/if}}{{/if}}
    </div>{{/if}}
    {{/if}}
  </fieldset>
  {{/with}}
  {{#with henchmen as |h|}}
  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Henchmen.Title"}}</legend>
    <div class="ad2e-prof-summary">
      <span class="{{#if h.over}}ad2e-unmet{{/if}}" data-tooltip="{{localize 'AD2E.Henchmen.LifetimeHint'}}">{{localize "AD2E.Henchmen.Lifetime"}}: <strong>{{h.lifetime}} / {{h.max}}</strong></span>
      <label data-tooltip="{{localize 'AD2E.Henchmen.LostHint'}}">{{localize "AD2E.Henchmen.Lost"}} <input type="number" name="system.henchmen.lost" value="{{h.lost}}" min="0" step="1" {{#unless @root.editable}}disabled{{/unless}}></label>
      <span data-tooltip="{{localize 'AD2E.Henchmen.LoyaltyHint'}}">{{localize "AD2E.Henchmen.Loyalty"}}: <strong>{{h.loyaltyText}}</strong></span>
      <span>{{localize "AD2E.Henchmen.Morale"}}: <strong>{{h.morale}}</strong></span>
    </div>
    {{#each h.rows as |r|}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{r.uuid}}">{{r.name}}</a></span>
        <span class="ad2e-weapon-meta">{{r.detail}}</span>
        {{#if r.tooHigh}}<span class="ad2e-weapon-meta ad2e-unmet">{{localize "AD2E.Henchmen.TooHigh"}}</span>{{/if}}
      </div>
      <button type="button" data-action="henchmanMorale" data-uuid="{{r.uuid}}">{{localize "AD2E.Monster.Morale"}}</button>
      {{#if @root.editable}}<a data-action="removeHenchman" data-uuid="{{r.uuid}}" data-tooltip="{{localize 'AD2E.Henchmen.Remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Henchmen.DropHint"}}</p>
    {{/each}}
  </fieldset>
  {{/with}}
  {{#with followers as |f|}}
  <fieldset class="ad2e-prof-list">
    <legend>{{localize "AD2E.Followers.Title"}}</legend>
    <div class="ad2e-prof-summary">
      <label>{{localize "AD2E.Followers.Stronghold"}} <input type="text" name="system.followers.stronghold.name" value="{{f.stronghold.name}}" placeholder="—" {{#unless @root.editable}}disabled{{/unless}}></label>
      <select name="system.followers.stronghold.kind" {{#unless @root.editable}}disabled{{/unless}}><option value="">—</option>{{#each f.kinds as |k|}}<option value="{{k.key}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>{{/each}}</select>
      <label data-tooltip="{{localize 'AD2E.Followers.BuiltHint'}}"><input type="checkbox" name="system.followers.stronghold.built" {{checked f.stronghold.built}} {{#unless @root.editable}}disabled{{/unless}}> {{localize "AD2E.Followers.Built"}}</label>
    </div>
    {{#with @root.castle as |c|}}
    <details class="ad2e-castle" {{#if c.building}}open{{/if}}>
      <summary>{{localize "AD2E.Castle.Title"}}{{#if c.building}} — {{c.progressPct}}%{{/if}}{{#if c.done}} — {{localize "AD2E.Castle.Finished"}}{{/if}}</summary>
      <p class="ad2e-note">{{localize "AD2E.Castle.Hint"}}</p>
      <div class="ad2e-check-grid">
        {{#each c.site as |st|}}<label{{#if st.gmOnly}} data-tooltip="{{localize 'AD2E.Castle.GmOnly'}}"{{/if}}>{{st.label}} <select class="ad2e-castle-field" data-castle="site.{{st.key}}" {{#if st.disabled}}disabled{{/if}}>{{#each st.options as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>{{/each}}
        <label>{{localize "AD2E.Castle.Tech"}} <select class="ad2e-castle-field" data-castle="tech" {{#unless c.editable}}disabled{{/unless}}>{{#each c.techs as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
      </div>
      <table class="ad2e-race-table">
        <thead><tr><th>{{localize "AD2E.Castle.Module"}}</th><th>{{localize "AD2E.Castle.Count"}}</th><th>{{localize "AD2E.Castle.StyleLabel"}}</th><th></th></tr></thead>
        <tbody>
          {{#each c.modules as |m|}}<tr><th>{{m.label}}</th>
            <td><input type="number" class="ad2e-castle-field" data-castle="modules.{{m.index}}.count" value="{{m.count}}" min="0" step="1" {{#unless c.editable}}disabled{{/unless}}></td>
            <td><select class="ad2e-castle-field" data-castle="modules.{{m.index}}.style" {{#unless c.editable}}disabled{{/unless}}>{{#each m.styles as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></td>
            <td>{{#if c.editable}}<a data-action="castleRemoveModule" data-index="{{m.index}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</td></tr>
          {{else}}<tr><td colspan="4" class="ad2e-placeholder">{{localize "AD2E.Castle.NoModulesYet"}}</td></tr>{{/each}}
        </tbody>
      </table>
      {{#if c.editable}}<div class="ad2e-prof-summary">
        <select data-castle-new="module">{{#each c.moduleOptions as |o|}}<option value="{{o.key}}">{{o.label}}</option>{{/each}}</select>
        <input type="number" data-castle-new="count" value="1" min="1" step="1">
        <button type="button" data-action="castleAddModule"><i class="fa-solid fa-plus"></i> {{localize "AD2E.Castle.AddModule"}}</button>
      </div>{{/if}}
      <table class="ad2e-race-table">
        <thead><tr><th>{{localize "AD2E.Castle.Helper"}}</th><th>{{localize "AD2E.Castle.SuitLabel"}}</th><th>{{localize "AD2E.Castle.Men"}}</th><th></th></tr></thead>
        <tbody>
          {{#each c.helpers as |h|}}<tr><th>{{h.name}}</th>
            <td>{{#if h.showSuit}}<select class="ad2e-castle-field" data-castle="helpers.{{h.index}}.suit" {{#unless c.editable}}disabled{{/unless}}>{{#each h.suits as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>{{/if}}</td>
            <td>{{h.men}}</td>
            <td>{{#if c.editable}}<a data-action="castleRemoveHelper" data-index="{{h.index}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</td></tr>
          {{else}}<tr><td colspan="4" class="ad2e-placeholder">{{localize "AD2E.Castle.NoHelpers"}}</td></tr>{{/each}}
        </tbody>
      </table>
      {{#if c.editable}}<div class="ad2e-prof-summary">
        <button type="button" data-action="castleAddTokens" data-tooltip="{{localize 'AD2E.Castle.AddTokensHint'}}"><i class="fa-solid fa-users"></i> {{localize "AD2E.Castle.AddTokens"}}</button>
        {{#if c.items.length}}<select data-castle-new="item">{{#each c.items as |o|}}<option value="{{o.id}}">{{o.name}}</option>{{/each}}</select>
        <button type="button" data-action="castleAddItem"><i class="fa-solid fa-wand-sparkles"></i> {{localize "AD2E.Castle.AddItem"}}</button>{{/if}}
        <input type="text" data-castle-new="otherName" placeholder="{{localize 'AD2E.Castle.OtherName'}}">
        <input type="number" data-castle-new="otherMen" value="0" min="0" step="1">
        <button type="button" data-action="castleAddOther"><i class="fa-solid fa-plus"></i> {{localize "AD2E.Castle.AddOther"}}</button>
      </div>{{/if}}
      {{#with c.plan as |pl|}}
      <div class="ad2e-prof-summary">
        <label>{{localize "AD2E.Castle.Hired"}} <input type="number" class="ad2e-castle-field" data-castle="hired" value="{{pl.hired}}" min="0" step="1" {{#unless c.editable}}disabled{{/unless}}></label>
        <span>{{localize "AD2E.Castle.Standard" n=pl.standard}}</span>
        <span>{{localize "AD2E.Castle.PM" pm=pl.pm}}</span>
      </div>
      <p>{{localize "AD2E.Castle.Summary" base=pl.base.gold overhead=pl.overheadGold gold=pl.gold hire=pl.hireCost total=pl.totalCost manWeeks=pl.manWeeks}}</p>
      <p>{{#if pl.weeks}}{{localize "AD2E.Castle.Timing" workers=pl.effective helpers=pl.helpers weeks=pl.weeks perYear=pl.workWeeks calendar=pl.calendarWeeks}}{{else}}<span class="ad2e-unmet">{{localize "AD2E.Castle.TooFew"}}</span>{{/if}}</p>
      {{#if pl.aboveTech.length}}<p class="ad2e-unmet">{{localize "AD2E.Castle.AboveTech"}} {{#each pl.aboveTech as |t|}}{{t}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
      {{/with}}
      {{#if c.building}}
      <p><progress value="{{c.progressPct}}" max="100"></progress> {{localize "AD2E.Castle.Progress" done=c.p.progress remaining=c.remaining extra=c.p.extraWeeks cost=c.p.extraCost lost=c.p.lost}}</p>
      {{#if c.halted}}<p class="ad2e-unmet">{{localize "AD2E.Castle.Halted"}}</p>{{/if}}
      {{#each c.problems as |pr|}}<p class="ad2e-unmet">{{pr.label}}{{#if c.isGM}} <a data-action="castleResolve" data-key="{{pr.key}}">{{localize "AD2E.Castle.Choice.resolve"}}</a>{{/if}}</p>{{/each}}
      {{/if}}
      {{#if c.log.length}}<ul class="ad2e-note">{{#each c.log as |l|}}<li>{{l.text}}</li>{{/each}}</ul>{{/if}}
      {{#if c.isGM}}<div class="ad2e-prof-summary">
        {{#unless c.p.status}}<button type="button" data-action="castleStart"><i class="fa-solid fa-hammer"></i> {{localize "AD2E.Castle.Start"}}</button>{{/unless}}
        {{#if c.p.status}}<button type="button" data-action="castleStop"><i class="fa-solid fa-rotate-left"></i> {{localize "AD2E.Castle.Stop"}}</button>{{/if}}
      </div>{{/if}}
      <p class="ad2e-note"><a href="{{c.urls.site}}" target="_blank" rel="noopener">The Construction Site (TCG)</a> · <a href="{{c.urls.design}}" target="_blank" rel="noopener">Castle Design (TCG)</a> · <a href="{{c.urls.work}}" target="_blank" rel="noopener">The Work Force (TCG)</a> · <a href="{{c.urls.events}}" target="_blank" rel="noopener">Monthly Events (TCG)</a></p>
    </details>
    {{/with}}
    {{#each f.status as |s|}}
    <div class="ad2e-prof-summary">
      <span>{{s.label}}</span>
      {{#if s.ready}}{{#if f.isGM}}<button type="button" data-action="attractFollowers" data-class="{{s.id}}"><i class="fa-solid fa-flag"></i> {{localize "AD2E.Followers.Attract"}}</button>{{else}}<span class="ad2e-weapon-meta">{{localize "AD2E.Followers.AskGM"}}</span>{{/if}}
      {{else}}<span class="ad2e-weapon-meta">{{s.reasonText}}</span>{{/if}}
    </div>
    {{/each}}
    {{#each f.rows as |r|}}
    <div class="ad2e-prof-row ad2e-armor-row">
      <img src="{{r.img}}" alt="" width="24" height="24">
      <div class="ad2e-weapon-main">
        <span class="ad2e-item-title"><a class="ad2e-prof-name" data-action="openHenchman" data-uuid="{{r.uuid}}">{{r.name}}</a></span>
        <span class="ad2e-weapon-meta">{{r.detail}}</span>
      </div>
      {{#if @root.editable}}<a data-action="removeFollower" data-uuid="{{r.uuid}}" data-tooltip="{{localize 'AD2E.Followers.Remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Followers.DropHint"}}</p>
    {{/each}}
  </fieldset>
  {{/with}}
  <div class="form-group ad2e-age"><label>{{localize "AD2E.Character.age"}}</label>
    <input type="number" name="system.age" value="{{system.age}}" min="0" step="1" placeholder="—">
    {{#if aging.canRollStart}}<button type="button" data-action="rollStartingAge" data-tooltip="{{aging.startFormula}}"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Aging.RollStart"}}</button>{{/if}}
    {{#if aging.category}}<span class="ad2e-weapon-meta" data-tooltip="{{aging.limits}}">{{aging.category}}{{#if aging.changes}} ({{aging.changes}}){{/if}}</span>{{/if}}
    {{#if aging.isGM}}<label data-tooltip="{{localize 'AD2E.Aging.MaxHint'}}">{{localize "AD2E.Aging.MaxAge"}} <input type="number" name="system.maxAge" value="{{system.maxAge}}" min="0" step="1" placeholder="—"></label>
    {{#if aging.maxFormula}}<button type="button" data-action="rollMaxAge" data-tooltip="{{aging.maxFormula}}"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Aging.RollMax"}}</button>{{/if}}{{/if}}</div>
  {{#with station as |s|}}
  <fieldset class="ad2e-prof-list ad2e-station">
    <legend data-tooltip="{{localize 'AD2E.Station.Hint'}}">{{localize "AD2E.Station.Label"}}</legend>
    <div class="ad2e-prof-row">
      <span class="ad2e-prof-name">{{#if s.set}}<strong>{{s.value}}</strong>{{else}}{{localize "AD2E.Station.NotSet"}}{{/if}}</span>
      <span class="ad2e-weapon-meta">{{#if s.kitName}}{{s.kitName}}{{#if s.formula}} ({{s.formula}}){{/if}}{{/if}}{{#if s.state}} · {{s.state}}{{/if}}{{#if s.bonus}} · {{localize "AD2E.Station.BonusText" n=s.bonus days=s.bonusUntil}}{{/if}}</span>
      {{#if s.canRoll}}<button type="button" data-action="stationRoll"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Station.Roll"}}</button>{{/if}}
      {{#if s.set}}<button type="button" data-action="stationCheck" data-tooltip="{{localize 'AD2E.Station.CheckHint'}}">{{localize "AD2E.Station.Check"}}</button>{{/if}}
    </div>
    <div class="ad2e-prof-row">
      {{#if s.isGM}}<label>{{localize "AD2E.Station.Initial"}} <input type="number" name="system.station.base" value="{{@root.system.station.base}}" min="0" max="20" step="1" placeholder="—"></label>{{/if}}
      {{#if s.editable}}<label data-tooltip="{{localize 'AD2E.Station.SpendHint'}}">{{localize "AD2E.Station.Spend"}} <input type="number" class="ad2e-station-spend" value="1" min="1" step="1"></label>
      <button type="button" data-action="stationSpend"><i class="fa-solid fa-coins"></i> {{localize "AD2E.Station.SpendButton"}}</button>{{/if}}
    </div>
    {{#if s.isGM}}
    <div class="ad2e-prof-row">
      <button type="button" data-action="stationConvict">{{#if s.criminal}}{{localize "AD2E.Station.Pardon"}}{{else}}{{localize "AD2E.Station.Convict"}}{{/if}}</button>
      <button type="button" data-action="stationPenniless">{{#if s.penniless}}{{localize "AD2E.Station.NotPenniless"}}{{else}}{{localize "AD2E.Station.Penniless"}}{{/if}}</button>
      <button type="button" data-action="stationEnslave">{{#if s.slave}}{{localize "AD2E.Station.Free"}}{{else}}{{localize "AD2E.Station.Enslave"}}{{/if}}</button>
    </div>
    {{/if}}
  </fieldset>
  {{/with}}
  {{#with body as |b|}}
  <div class="form-group ad2e-body"><label>{{localize "AD2E.Gender.Label"}}</label>
    <select name="system.gender">{{selectOptions b.genders selected=@root.system.gender}}</select>
    <label data-tooltip="{{localize 'AD2E.Gender.BuildHint'}}">{{localize "AD2E.Gender.BuildLabel"}} <select name="system.build">{{selectOptions b.builds selected=@root.system.build}}</select></label>
    <label>{{localize "AD2E.Gender.Height"}} <input type="number" name="system.height" value="{{@root.system.height}}" min="0" step="1" placeholder="—"></label>
    {{#if b.feet}}<span class="ad2e-weapon-meta">{{b.feet}}</span>{{/if}}
    <span class="ad2e-weapon-meta" data-tooltip="{{localize 'AD2E.Animal.BodyWeightHint'}}">{{localize "AD2E.Animal.BodyWeight"}}: {{#if b.weight}}{{b.weight}}{{else}}—{{/if}}</span>
    {{#if b.canRoll}}<button type="button" data-action="rollHeightWeight" data-tooltip="{{localize 'AD2E.Gender.RollHint'}}"><i class="fa-solid fa-dice"></i> {{localize "AD2E.Gender.Roll"}}</button>{{/if}}</div>
  {{/with}}
  <textarea class="ad2e-biography" name="system.biography">{{system.biography}}</textarea>
</section>
