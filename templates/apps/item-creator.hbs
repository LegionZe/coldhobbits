<section class="ad2e-creator">
  <div class="ad2e-creator-body">
  <p class="ad2e-note">{{localize "AD2E.Creator.Item.Hint"}}</p>
  <fieldset>
    <legend>{{localize "AD2E.Creator.Item.Step1"}}</legend>
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.KindLabel"}}</label><select data-field="kind">{{#each kinds as |k|}}<option value="{{k.key}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>{{/each}}</select></div>
    <div class="form-group"><label>{{localize "AD2E.Creator.Weapon.StartFrom"}}</label><select data-field="source">
      <option value="">{{localize "AD2E.Creator.Item.Blank"}}</option>
      {{#each sourceOptions as |o|}}<option value="{{o.uuid}}" {{#if o.selected}}selected{{/if}}>{{o.name}} ({{o.origin}})</option>{{/each}}</select></div>
    <div class="form-group"><label>{{localize "AD2E.Character.Name"}}</label><input type="text" data-field="name" value="{{s.name}}"></div>
    <div class="form-group"><label>{{localize "AD2E.Item.identifier"}}</label><input type="text" data-field="identifier" value="{{s.identifier}}" placeholder="{{ident}}"></div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.Cost"}}</label><input type="text" data-field="cost" value="{{s.cost}}" placeholder="5 gp"></div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.Weight"}}</label><input type="number" data-field="weight" value="{{s.weight}}" min="0" step="any"></div>
  </fieldset>
  <fieldset>
    <legend>{{localize "AD2E.Creator.Item.Step2"}}</legend>
    {{#if is.gear}}
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.Category"}}</label><select data-field="category">{{#each categories as |c|}}<option value="{{c.key}}" {{#if c.selected}}selected{{/if}}>{{c.label}}</option>{{/each}}</select></div>
    {{/if}}
    {{#if is.container}}
    <p class="ad2e-note">{{localize "AD2E.Creator.Item.ContainerHint"}}</p>
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.CapacityWeight"}}</label><input type="number" data-field="capacityWeight" value="{{s.capacityWeight}}" min="0" step="any"></div>
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.CapacityVolume"}}</label><input type="text" data-field="capacityVolume" value="{{s.capacityVolume}}" placeholder="2' x 2' x 1'"></div>
    {{/if}}
    {{#if is.armor}}
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.ArmorKind"}}</label><select data-field="armorKind">{{#each armorKinds as |k|}}<option value="{{k.key}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>{{/each}}</select></div>
    {{#if is.body}}<div class="form-group"><label>{{localize "AD2E.Armor.AC"}}</label><input type="number" data-field="ac" value="{{s.ac}}" min="-10" max="10" step="1"></div>{{/if}}
    {{#if is.shield}}
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.ShieldMelee"}}</label><input type="number" data-field="shieldMelee" value="{{s.shieldMelee}}" min="0" step="1"></div>
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.ShieldMissile"}}</label><input type="number" data-field="shieldMissile" value="{{s.shieldMissile}}" min="0" step="1"></div>
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.ShieldAttacks"}}</label><input type="number" data-field="shieldAttacks" value="{{s.shieldAttacks}}" min="1" step="1" placeholder="{{localize 'AD2E.Armor.AnyFrontal'}}"></div>
    {{/if}}
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.MadeFor"}}</label><select data-field="size">{{#each armorSizes as |z|}}<option value="{{z.key}}" {{#if z.selected}}selected{{/if}}>{{z.label}}</option>{{/each}}</select></div>
    <div class="form-group"><label>{{localize "AD2E.Creator.Item.ArmorBonus"}}</label><input type="number" data-field="bonus" value="{{s.bonus}}" step="1"></div>
    {{/if}}
    {{#if is.ammunition}}
    <div class="form-group"><label>{{localize "AD2E.Ammo.Launchers"}}</label></div>
    <div class="ad2e-check-grid">{{#each launcherOptions as |l|}}<label><input type="checkbox" data-field="launcher" data-key="{{l.identifier}}" {{#if l.checked}}checked{{/if}}> {{l.name}}</label>{{/each}}</div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.Type"}}</label><input type="text" data-field="ammoType" value="{{s.ammoType}}" placeholder="P"></div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.Size"}}</label><input type="text" data-field="ammoSize" value="{{s.ammoSize}}" placeholder="S"></div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.Damage"}}</label><input type="text" data-field="damageSm" value="{{s.damageSm}}" placeholder="S-M 1d6"><input type="text" data-field="damageL" value="{{s.damageL}}" placeholder="L 1d6"></div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.MagicHit"}}</label><input type="number" data-field="hit" value="{{s.hit}}" step="1"></div>
    <div class="form-group"><label>{{localize "AD2E.Weapon.MagicDmg"}}</label><input type="number" data-field="dmg" value="{{s.dmg}}" step="1"></div>
    {{/if}}
    <div class="form-group"><label>{{localize "AD2E.Item.notes"}}</label><textarea data-field="notes" rows="3">{{s.notes}}</textarea></div>
  </fieldset>
  {{#each issues as |i|}}<p class="ad2e-unmet">{{i}}</p>{{/each}}
  </div>
  <div class="ad2e-importer-controls ad2e-importer-actions">
    <label>{{localize "AD2E.Creator.Destination"}} <select data-field="destination">{{#each destinations as |d|}}<option value="{{d.key}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>{{/each}}</select></label>
    <button type="button" data-action="create"><i class="fa-solid fa-plus"></i> {{localize "AD2E.Creator.Create"}}</button>
  </div>
</section>
