<section class="ad2e-item-sheet">
  <header class="ad2e-item-header">
    <img src="{{item.img}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}} alt="" width="48" height="48">
    {{#if hidden}}<input class="ad2e-name" type="text" value="{{item.name}}" disabled>{{else}}<input class="ad2e-name" type="text" name="name" value="{{sourceName}}">{{/if}}
    {{#if system.url}}<a class="ad2e-item-link ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}: {{system.url}}"><i class="fa-solid fa-book-open"></i> {{localize "AD2E.Item.Source"}}</a>{{/if}}
  </header>
  <div class="ad2e-item-fields">
    {{> "ad2e.item-material"}}
    {{#if containerOptions}}<label>{{localize "AD2E.Container.InContainer"}}
      <select name="system.container">{{#each containerOptions as |o|}}<option value="{{o.id}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>{{/each}}</select></label>{{/if}}
    {{#unless hidden}}<label>{{localize "AD2E.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}"></label>{{/unless}}
    <label data-tooltip="{{localize 'AD2E.Weapon.ProficiencyHint'}}">{{localize "AD2E.Weapon.Proficiency"}} <select name="system.proficiency">{{#each profOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
    <label>{{localize "AD2E.Weapon.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label>
    <label>{{localize "AD2E.Weapon.Cost"}} <input type="text" name="system.cost" value="{{system.cost}}"></label>
    <label>{{localize "AD2E.Weapon.Weight"}} <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="any"></label>
    {{#unless hidden}}
    <label>{{localize "AD2E.Weapon.MagicHit"}} <input type="number" name="system.bonus.hit" value="{{system.bonus.hit}}"></label>
    <label>{{localize "AD2E.Weapon.MagicDmg"}} <input type="number" name="system.bonus.dmg" value="{{system.bonus.dmg}}"></label>
    {{/unless}}
    {{#if isBow}}<label data-tooltip="{{localize 'AD2E.Weapon.BowStrengthHint'}}">{{localize "AD2E.Weapon.BowStrength"}} <select name="system.bowStrength">{{#each bowStrengthOptions as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>{{/if}}
    <label data-tooltip="{{localize 'AD2E.Weapon.ElementHint'}}">{{localize "AD2E.Monster.Element"}} <select name="system.element">{{#each elementOptions as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
    <label>{{localize "AD2E.Class.Source"}} <input type="text" name="system.source" value="{{system.source}}"></label>
    {{#unless hidden}}<label>{{localize "AD2E.Item.url"}} <input type="text" name="system.url" value="{{system.url}}"></label>{{/unless}}
    {{#if isGM}}<label class="ad2e-check" data-tooltip="{{localize 'AD2E.Identify.Hint'}}"><input type="checkbox" name="system.identified" {{checked system.identified}}> {{localize "AD2E.Magic.Identified"}}</label>
    <label data-tooltip="{{localize 'AD2E.Identify.NameHint'}}">{{localize "AD2E.Identify.Name"}} <input type="text" name="system.unidentifiedName" value="{{system.unidentifiedName}}"></label>{{else}}{{#unless system.identified}}<p class="ad2e-note">{{localize "AD2E.Magic.Unidentified"}}</p>{{/unless}}{{/if}}
  </div>
  {{#if linked}}<p class="ad2e-note">{{linked}}</p>{{/if}}
  {{> "ad2e.poison-coat"}}
  <fieldset class="ad2e-weapon-details">
    <legend>{{localize "AD2E.Weapon.Details"}}</legend>
    {{#with weaponEdit as |we|}}
    <div class="ad2e-item-fields">
      <label>{{localize "AD2E.Weapon.Size"}} <select name="system.weapon.size">{{#each we.sizes as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
      <label>{{localize "AD2E.Weapon.Type"}} <input type="text" name="system.weapon.type" value="{{@root.system.weapon.type}}" placeholder="S, P, B, P/S"></label>
      <label>{{localize "AD2E.Weapon.Speed"}} <input type="number" name="system.weapon.speed" value="{{@root.system.weapon.speed}}" step="1"></label>
      <label>{{localize "AD2E.Creator.Weapon.Strength.label"}} <select name="system.weapon.strength">{{#each we.strengths as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
      <label class="ad2e-check"><input type="checkbox" name="system.weapon.melee" {{checked @root.system.weapon.melee}}> {{localize "AD2E.Weapon.melee"}}</label>
      <label class="ad2e-check"><input type="checkbox" name="system.weapon.missile" {{checked @root.system.weapon.missile}}> {{localize "AD2E.Weapon.missile"}}</label>
      <label class="ad2e-check"><input type="checkbox" data-action="toggleTwoHands" {{checked we.twoHands}}> {{localize "AD2E.Creator.Weapon.TwoHands"}}</label>
    </div>
    <table class="ad2e-weapon-damage-edit">
      <thead><tr><th>{{localize "AD2E.Creator.Weapon.DamageLabel"}}</th><th>{{localize "AD2E.Weapon.DamageSM"}}</th><th>{{localize "AD2E.Weapon.DamageL"}}</th><th>{{localize "AD2E.Weapon.Speed"}}</th><th></th></tr></thead>
      <tbody>
        {{#each we.damage as |d|}}
        <tr>
          <td><input type="text" name="system.weapon.damage.{{d.index}}.label" value="{{d.label}}"></td>
          <td><input type="text" name="system.weapon.damage.{{d.index}}.sm" value="{{d.sm}}" placeholder="1d8"></td>
          <td><input type="text" name="system.weapon.damage.{{d.index}}.l" value="{{d.l}}" placeholder="1d12"></td>
          <td><input type="number" name="system.weapon.damage.{{d.index}}.speed" value="{{d.speed}}" step="1"></td>
          <td><a data-action="removeWeaponDamage" data-index="{{d.index}}" data-tooltip="{{localize 'AD2E.Item.remove'}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <button type="button" data-action="addWeaponDamage"><i class="fa-solid fa-plus"></i> {{localize "AD2E.Weapon.AddDamage"}}</button>
    {{#if @root.system.weapon.missile}}
    <div class="ad2e-item-fields">
      <label>{{localize "AD2E.Weapon.ROF"}} <input type="text" name="system.weapon.range.rof" value="{{@root.system.weapon.range.rof}}" placeholder="1, 2, 3/2"></label>
      <label>{{localize "AD2E.Creator.Weapon.Family.label"}} <select name="system.weapon.family">{{#each we.families as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
      <label>{{localize "AD2E.Weapon.Short"}} <input type="text" name="system.weapon.range.short" value="{{@root.system.weapon.range.short}}"></label>
      <label>{{localize "AD2E.Weapon.Medium"}} <input type="text" name="system.weapon.range.medium" value="{{@root.system.weapon.range.medium}}"></label>
      <label>{{localize "AD2E.Weapon.Long"}} <input type="text" name="system.weapon.range.long" value="{{@root.system.weapon.range.long}}"></label>
      <label>{{localize "AD2E.Creator.Weapon.Column"}} <select name="system.weapon.missileColumn">{{#each we.columns as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
    </div>
    <p class="ad2e-note">{{localize "AD2E.Weapon.RangeNote"}}</p>
    {{/if}}
    {{else}}
    <dl class="ad2e-weapon-stats">
      <dt>{{localize "AD2E.Weapon.Size"}}</dt><dd>{{weapon.size}}</dd>
      <dt>{{localize "AD2E.Weapon.Type"}}</dt><dd>{{weapon.type}}</dd>
      <dt>{{localize "AD2E.Weapon.Speed"}}</dt><dd>{{weapon.speed}}</dd>
      <dt>{{localize "AD2E.Weapon.melee"}} / {{localize "AD2E.Weapon.missile"}}</dt><dd>{{weapon.uses}}</dd>
      {{#each weapon.damage as |d|}}
      <dt>{{localize "AD2E.Weapon.Damage"}}{{#if d.label}} ({{d.label}}){{/if}}</dt><dd>{{d.sm}} / {{d.l}}</dd>
      {{/each}}
      {{#if weapon.missile}}
      <dt>{{localize "AD2E.Weapon.ROF"}}</dt><dd>{{weapon.range.rof}}</dd>
      <dt>{{localize "AD2E.Weapon.MissileRange"}}</dt><dd>{{weapon.range.short}} / {{weapon.range.medium}} / {{weapon.range.long}}</dd>
      {{/if}}
    </dl>
    {{/with}}
  </fieldset>
  {{#with attackFx as |fx|}}
  <fieldset class="ad2e-weapon-fx">
    <legend>{{localize "AD2E.Animation.WeaponLegend"}}</legend>
    <div class="ad2e-item-fields">
      <label data-tooltip="{{localize 'AD2E.Animation.WeaponFileHint'}}">{{localize "AD2E.Animation.File"}} <input type="text" name="system.animation.file" value="{{@root.system.animation.file}}" placeholder="{{localize 'AD2E.Animation.Automatic'}}"></label>
      <label data-tooltip="{{localize 'AD2E.Sound.FileHint'}}">{{localize "AD2E.Sound.File"}} <input type="text" name="system.animation.sound" value="{{@root.system.animation.sound}}" placeholder="{{localize 'AD2E.Animation.Automatic'}}"></label>
    </div>
    <p class="ad2e-note">{{localize "AD2E.Animation.Automatic"}}: {{fx.animation}}{{#unless fx.animationReady}} ({{localize "AD2E.Animation.NotAvailable"}}){{/unless}}</p>
    <p class="ad2e-note">{{localize "AD2E.Sound.Automatic"}}: {{fx.sound}}{{#unless fx.soundReady}} ({{localize "AD2E.Sound.NotAvailable"}}){{/unless}}</p>
  </fieldset>
  {{/with}}
  {{#unless hidden}}<label class="ad2e-notes">{{localize "AD2E.Item.notes"}}
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>{{/unless}}
</section>
