<section class="ad2e-item-sheet">
  <header class="ad2e-item-header">
    <img src="{{item.img}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}} alt="" width="48" height="48">
    <input class="ad2e-name" type="text" name="name" value="{{item.name}}">
    {{#if system.url}}<a class="ad2e-item-link ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}: {{system.url}}"><i class="fa-solid fa-book-open"></i> {{localize "AD2E.Item.Source"}}</a>{{/if}}
  </header>
  <div class="ad2e-item-fields">
    <label>{{localize "AD2E.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}"></label>
    <label>{{localize "AD2E.Prof.Kind"}}
      <select name="system.kind">{{selectOptions kinds selected=system.kind localize=true}}</select></label>
    <label>{{localize "AD2E.Prof.Slots"}} <input type="number" name="system.slots" value="{{system.slots}}" min="0"></label>
    {{#if isNonweapon}}<label data-tooltip="{{localize 'AD2E.Prof.ExtraHint'}}">{{localize "AD2E.Prof.ExtraSlots"}} <input type="number" name="system.extraSlots" value="{{system.extraSlots}}" min="0"></label>{{/if}}
    <label>{{localize "AD2E.Prof.Ability"}}
      <select name="system.ability">{{selectOptions abilityLabels selected=system.ability localize=true blank=(localize "AD2E.Prof.NoCheck")}}</select></label>
    <label>{{localize "AD2E.Prof.Modifier"}} <input type="number" name="system.modifier" value="{{system.modifier}}"></label>
    <label>{{localize "AD2E.Prof.Groups"}}
      <multi-select name="system.groups">{{selectOptions nonweaponGroups selected=groupList localize=true}}</multi-select></label>
    <label>{{localize "AD2E.Class.Source"}} <input type="text" name="system.source" value="{{system.source}}"></label>
    <label>{{localize "AD2E.Item.url"}} <input type="text" name="system.url" value="{{system.url}}"></label>
    {{#if system.grantedBy}}<p class="ad2e-note">{{localize "AD2E.Prof.GrantedBy"}}: {{system.grantedBy}}</p>{{/if}}
  </div>
  {{#if isWeapon}}
  <fieldset class="ad2e-weapon-details">
    <legend>{{localize "AD2E.Weapon.Details"}}</legend>
    <label class="ad2e-check"><input type="checkbox" name="system.specialized" {{checked system.specialized}}>
      {{localize "AD2E.Weapon.Specialized"}}</label>
    <p class="ad2e-note">{{localize "AD2E.Weapon.Specialize"}}</p>
    <label class="ad2e-check"><input type="checkbox" name="system.choice" {{checked system.choice}}> {{localize "AD2E.SP.Choice"}}</label>
    <label class="ad2e-check"><input type="checkbox" name="system.expertise" {{checked system.expertise}}> {{localize "AD2E.SP.Expertise"}}</label>
    <label class="ad2e-check"><input type="checkbox" name="system.mastery" {{checked system.mastery}}> {{localize "AD2E.SP.Mastery"}}</label>
    <p class="ad2e-note">{{localize "AD2E.SP.WeaponNote"}}</p>
    <dl class="ad2e-weapon-stats">
      <dt>{{localize "AD2E.Weapon.Size"}}</dt><dd>{{weapon.size}}</dd>
      <dt>{{localize "AD2E.Weapon.Type"}}</dt><dd>{{weapon.type}}</dd>
      <dt>{{localize "AD2E.Weapon.Speed"}}</dt><dd>{{weapon.speed}}</dd>
      <dt>{{localize "AD2E.Weapon.melee"}} / {{localize "AD2E.Weapon.missile"}}</dt><dd>{{weapon.uses}}</dd>
      {{#each weapon.damage as |d|}}
      <dt>{{localize "AD2E.Weapon.Damage"}}{{#if d.label}} ({{d.label}}){{/if}}</dt><dd>{{d.sm}} / {{d.l}}</dd>
      {{/each}}
      {{#if weapon.missile}}
      <dt>{{localize "AD2E.Weapon.ROF"}}</dt><dd>{{weapon.range.rof}}</dd>
      <dt>{{localize "AD2E.Weapon.MissileRange"}}</dt><dd>{{weapon.range.short}} / {{weapon.range.medium}} / {{weapon.range.long}}</dd>
      {{/if}}
    </dl>
  </fieldset>
  {{/if}}
  {{#if spKind.group}}
  <div class="ad2e-item-fields"><label>{{localize "AD2E.SP.Kind.group"}}
    <select name="system.spGroup">{{selectOptions spGroups selected=system.spGroup blank="—"}}</select></label></div>
  {{/if}}
  {{#if spKind.style}}
  <div class="ad2e-item-fields"><label>{{localize "AD2E.SP.Kind.style"}}
    <select name="system.style">{{selectOptions spStyles selected=system.style blank="—"}}</select></label>
    <label class="ad2e-check"><input type="checkbox" name="system.improved" {{checked system.improved}}> {{localize "AD2E.SP.Improved"}}</label></div>
  {{/if}}
  {{#if spKind.armor}}
  <div class="ad2e-item-fields"><label>{{localize "AD2E.SP.ArmorType"}} <input type="text" name="system.armorType" value="{{system.armorType}}"></label></div>
  {{/if}}
  {{#if spKind.shield}}
  <div class="ad2e-item-fields"><label>{{localize "AD2E.SP.Kind.shield"}}
    <select name="system.shieldType">{{selectOptions spShields selected=system.shieldType blank="—" localize=true}}</select></label></div>
  {{/if}}
  <fieldset>
    <legend>{{localize "AD2E.Prof.SkillsPowers"}}</legend>
    <div class="ad2e-item-fields">
      <label>{{localize "AD2E.Prof.Ability"}} <input type="text" name="system.sp.ability" value="{{system.sp.ability}}"></label>
      <label>{{localize "AD2E.Prof.Rating"}} <input type="number" name="system.sp.rating" value="{{system.sp.rating}}"></label>
      <label>{{localize "AD2E.Prof.Cost"}} <input type="number" name="system.sp.cost" value="{{system.sp.cost}}"></label>
    </div>
  </fieldset>
  <label class="ad2e-notes">{{localize "AD2E.Item.notes"}}
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
</section>
