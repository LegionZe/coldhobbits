<section class="ad2e-item-sheet">
  <header class="ad2e-item-header">
    <img src="{{item.img}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}} alt="" width="48" height="48">
    <input class="ad2e-name" type="text" name="name" value="{{item.name}}">
    {{#if system.url}}<a class="ad2e-item-link ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}: {{system.url}}"><i class="fa-solid fa-book-open"></i> {{localize "AD2E.Item.Source"}}</a>{{/if}}
  </header>
  <div class="ad2e-item-fields">
    <label>{{localize "AD2E.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}"></label>
    <label>{{localize "AD2E.Item.kitClasses"}} <input type="text" name="classesText" value="{{classesText}}" data-tooltip="{{localize 'AD2E.Item.kitClassesHint'}}"></label>
    <label>{{localize "AD2E.Class.Source"}} <input type="text" name="system.source" value="{{system.source}}"></label>
    <label>{{localize "AD2E.Item.url"}} <input type="text" name="system.url" value="{{system.url}}"></label>
    <label>{{localize "AD2E.Race.KitRaceLimits"}} <input type="text" name="raceLimitsText" value="{{raceLimitsText}}" data-tooltip="{{localize 'AD2E.Race.KitRaceLimitsHint'}}"></label>
    <label class="ad2e-checkbox"><input type="checkbox" name="system.raceOnly" {{#if system.raceOnly}}checked{{/if}}> {{localize "AD2E.Race.RaceOnly"}}</label>
    <label>{{localize "AD2E.Race.KitRacesBarred"}} <input type="text" name="racesBarredText" value="{{racesBarredText}}" data-tooltip="{{localize 'AD2E.Race.KitRacesBarredHint'}}"></label>
    <label>{{localize "AD2E.Weapon.AllowedWeapons"}} <input type="text" name="allowedWeaponsText" value="{{allowedWeaponsText}}" placeholder="{{localize 'AD2E.Weapon.ClassList'}}" data-tooltip="{{localize 'AD2E.Weapon.KitAllowedHint'}}"></label>
    <label class="ad2e-checkbox" data-tooltip="{{localize 'AD2E.Weapon.WithinClassHint'}}"><input type="checkbox" name="system.weaponsWithinClass" {{#if system.weaponsWithinClass}}checked{{/if}}> {{localize "AD2E.Weapon.WithinClass"}}</label>
    <label>{{localize "AD2E.Weapon.ExtraWeapons"}} <input type="text" name="extraWeaponsText" value="{{extraWeaponsText}}" data-tooltip="{{localize 'AD2E.Weapon.ExtraWeaponsHint'}}"></label>
    <label>{{localize "AD2E.Weapon.ForbiddenWeapons"}} <input type="text" name="forbiddenWeaponsText" value="{{forbiddenWeaponsText}}" data-tooltip="{{localize 'AD2E.Weapon.ForbiddenWeaponsHint'}}"></label>
    <label>{{localize "AD2E.Weapon.InitialWeapons"}} <input type="text" name="initialWeaponsText" value="{{initialWeaponsText}}" data-tooltip="{{localize 'AD2E.Weapon.InitialWeaponsHint'}}"></label>
    <label>{{localize "AD2E.Weapon.InitialForbidden"}} <input type="text" name="initialForbiddenWeaponsText" value="{{initialForbiddenWeaponsText}}" data-tooltip="{{localize 'AD2E.Weapon.InitialForbiddenHint'}}"></label>
    <label>{{localize "AD2E.Weapon.WeaponNote"}} <input type="text" name="system.weaponNote" value="{{system.weaponNote}}"></label>
    <label class="ad2e-checkbox" data-tooltip="{{localize 'AD2E.Class.MinStacksHint'}}"><input type="checkbox" name="system.minStacks" {{#if system.minStacks}}checked{{/if}}> {{localize "AD2E.Class.MinStacks"}}</label>
    <label class="ad2e-checkbox"><input type="checkbox" name="system.otherRequirements" {{#if system.otherRequirements}}checked{{/if}}> {{localize "AD2E.Item.otherRequirements"}}</label>
  </div>
  <fieldset>
    <legend>{{localize "AD2E.Prof.Nonweapon"}}</legend>
    <dl class="ad2e-facts">
      <dt>{{localize "AD2E.Prof.Bonus"}}</dt><dd>{{#if kitBonusProfs}}{{kitBonusProfs}}{{else}}—{{/if}}</dd>
      <dt>{{localize "AD2E.Prof.Required"}}</dt><dd>{{#if kitRequiredProfs}}{{kitRequiredProfs}}{{else}}—{{/if}}</dd>
      <dt>{{localize "AD2E.Prof.Recommended"}}</dt><dd>{{#if kitRecommended}}{{kitRecommended}}{{else}}—{{/if}}</dd>
      <dt>{{localize "AD2E.Prof.Specialization"}}</dt><dd>{{#if kitSpecialization}}{{kitSpecialization}}{{else}}{{localize "AD2E.Prof.SpecClassRule"}}{{/if}}</dd>
    </dl>
    <div class="ad2e-item-fields">
      <label>{{localize "AD2E.Prof.BonusWeaponSlots"}} <input type="number" name="system.bonusSlots.weapon" value="{{system.bonusSlots.weapon}}" min="0"></label>
      <label>{{localize "AD2E.Prof.BonusNonweaponSlots"}} <input type="number" name="system.bonusSlots.nonweapon" value="{{system.bonusSlots.nonweapon}}" min="0"></label>
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "AD2E.Class.KitMin"}}</legend>
    <p class="ad2e-note">{{localize "AD2E.Item.kitMinHint"}}</p>
    <div class="ad2e-min-grid">
      {{#each minimums as |m|}}
      <label>{{m.label}} <input type="number" name="system.min.{{m.key}}" value="{{m.value}}" min="0" max="25"></label>
      {{/each}}
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "AD2E.Skill.KitAdjust"}}</legend>
    <p class="ad2e-note">{{localize "AD2E.Skill.KitAdjustHint"}}</p>
    <div class="ad2e-min-grid">
      {{#each skillAdjust as |s|}}
      <label>{{s.label}} <input type="number" name="system.skillAdjust.{{s.key}}" value="{{s.value}}" step="5"></label>
      {{/each}}
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "AD2E.Kit.Modifiers"}}</legend>
    <p class="ad2e-note">{{localize "AD2E.Kit.SheetHint"}}</p>
    {{#if kitPoints}}<p>{{kitPoints}}</p>{{/if}}
    {{#if kitModifiers.length}}<ul class="ad2e-kit-mods">{{#each kitModifiers as |t|}}<li>{{t}}</li>{{/each}}</ul>
    {{else}}<p class="ad2e-placeholder">{{localize "AD2E.Kit.NoModifiers"}}</p>{{/if}}
  </fieldset>
  <label class="ad2e-notes">{{localize "AD2E.Item.notes"}}
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
</section>
