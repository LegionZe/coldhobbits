<section class="ad2e-item-sheet">
  <header class="ad2e-item-header">
    <img src="{{item.img}}" data-edit="img" alt="" width="48" height="48">
    <input class="ad2e-name" type="text" name="name" value="{{item.name}}">
  </header>
  <div class="ad2e-item-fields">
    <label>{{localize "AD2E.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}"></label>
    <label>{{localize "AD2E.Treasure.Kind.label"}}
      <select name="system.kind">{{selectOptions kinds selected=system.kind localize=true}}</select></label>
    {{#if isGem}}
    <label>{{localize "AD2E.Treasure.Gem.label"}}
      <select name="system.gemClass">{{selectOptions gemClasses selected=system.gemClass localize=true}}</select></label>
    <label class="ad2e-check"><input type="checkbox" name="system.uncut" {{checked system.uncut}}> {{localize "AD2E.Treasure.Uncut"}}</label>
    {{/if}}
    <label>{{localize "AD2E.Treasure.ValueEach"}} <input type="number" name="system.value" value="{{system.value}}" min="0" step="any" placeholder="{{baseValue}}"></label>
    <label>{{localize "AD2E.Weapon.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1"></label>
    <label>{{localize "AD2E.Gear.WeightEach"}} <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="any"></label>
    <label class="ad2e-check"><input type="checkbox" name="system.carried" {{checked system.carried}}> {{localize "AD2E.Gear.Carried"}}</label>
    <label>{{localize "AD2E.Item.url"}} <input type="text" name="system.url" value="{{system.url}}"></label>
  </div>
  <p class="ad2e-note">{{localize "AD2E.Treasure.Worth"}}: {{#if unitValue}}{{unitValue}} gp{{else}}—{{/if}}{{#if totalValue}} · {{localize "AD2E.Gear.Total"}} {{totalValue}} gp{{/if}}</p>
  <p class="ad2e-note">{{localize "AD2E.Treasure.SheetHint"}}</p>
  <label class="ad2e-notes">{{localize "AD2E.Item.notes"}}
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
</section>
