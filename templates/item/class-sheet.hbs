<section class="ad2e-item-sheet">
  <header class="ad2e-item-header">
    <img src="{{item.img}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}} alt="" width="48" height="48">
    <input class="ad2e-name" type="text" name="name" value="{{item.name}}">
    {{#if system.url}}<a class="ad2e-item-link ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}: {{system.url}}"><i class="fa-solid fa-book-open"></i> {{localize "AD2E.Item.Source"}}</a>{{/if}}
  </header>
  <div class="ad2e-item-fields">
    <label>{{localize "AD2E.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}"></label>
    <label>{{localize "AD2E.Character.classGroup"}}
      <select name="system.group">{{selectOptions classGroups selected=system.group localize=true}}</select></label>
    <label>{{localize "AD2E.Class.PrimeRequisites"}}
      <multi-select name="system.prime">{{selectOptions abilityLabels selected=prime localize=true}}</multi-select></label>
    <label>{{localize "AD2E.Class.Alignments"}}
      <multi-select name="system.alignments">{{selectOptions alignments selected=alignmentList localize=true}}</multi-select></label>
    <label>{{localize "AD2E.Class.School"}} <input type="text" name="system.school" value="{{system.school}}"></label>
    <label>{{localize "AD2E.Class.Opposition"}} <input type="text" name="system.opposition" value="{{system.opposition}}"></label>
    <label>{{localize "AD2E.Item.url"}} <input type="text" name="system.url" value="{{system.url}}"></label>
    <label>{{localize "AD2E.Weapon.AllowedWeapons"}} <input type="text" name="allowedWeaponsText" value="{{allowedWeaponsText}}" data-tooltip="{{localize 'AD2E.Weapon.AllowedWeaponsHint'}}"></label>
  </div>
  <fieldset>
    <legend>{{localize "AD2E.Class.ClassMin"}}</legend>
    <div class="ad2e-min-grid">
      {{#each minimums as |m|}}
      <label>{{m.label}} <input type="number" name="system.min.{{m.key}}" value="{{m.value}}" min="0" max="25"></label>
      {{/each}}
    </div>
  </fieldset>
  <label class="ad2e-notes">{{localize "AD2E.Item.notes"}}
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
</section>
