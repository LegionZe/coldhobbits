<section class="ad2e-item-sheet">
  <header class="ad2e-item-header">
    <img src="{{item.img}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}} alt="" width="48" height="48">
    <input class="ad2e-name" type="text" name="name" value="{{item.name}}">
    {{#if system.url}}<a class="ad2e-item-link ad2e-source-link" href="{{system.url}}" target="_blank" rel="noopener" data-tooltip="{{localize 'AD2E.Item.Source'}}: {{system.url}}"><i class="fa-solid fa-book-open"></i> {{localize "AD2E.Item.Source"}}</a>{{/if}}
  </header>
  <div class="ad2e-item-fields">
    {{#if containerOptions}}<label>{{localize "AD2E.Container.InContainer"}}
      <select name="system.container">{{#each containerOptions as |o|}}<option value="{{o.id}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>{{/each}}</select></label>{{/if}}
    <label>{{localize "AD2E.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}"></label>
    <label>{{localize "AD2E.Gear.Category"}}
      <select name="system.category">{{selectOptions categories selected=system.category localize=true}}</select></label>
    <label>{{localize "AD2E.Weapon.Cost"}} <input type="text" name="system.cost" value="{{system.cost}}"></label>
    <label>{{localize "AD2E.Gear.WeightEach"}} <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="any"></label>
    <label>{{localize "AD2E.Weapon.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1"></label>
    <label class="ad2e-check"><input type="checkbox" name="system.carried" {{checked system.carried}}> {{localize "AD2E.Gear.Carried"}}</label>
    <label>{{localize "AD2E.Gear.Capacity"}} <input type="number" name="system.capacity.weight" value="{{system.capacity.weight}}" min="0"></label>
    <label>{{localize "AD2E.Gear.Volume"}} <input type="text" name="system.capacity.volume" value="{{system.capacity.volume}}"></label>
    <label>{{localize "AD2E.Gear.LoadFull"}} <input type="number" name="system.load.full" value="{{system.load.full}}" min="0"></label>
    <label>{{localize "AD2E.Gear.LoadHalf"}} <input type="number" name="system.load.half" value="{{system.load.half}}" min="0"></label>
    <label>{{localize "AD2E.Gear.LoadQuarter"}} <input type="number" name="system.load.quarter" value="{{system.load.quarter}}" min="0"></label>
    {{#if isComponent}}
    <label>{{localize "AD2E.Gear.CompGroup"}} <input type="text" name="system.component.group" value="{{system.component.group}}"></label>
    <label data-tooltip="{{localize 'AD2E.Gear.AcquisitionHint'}}">{{localize "AD2E.Gear.Acquisition"}} <input type="text" name="system.component.acquisition" value="{{system.component.acquisition}}"></label>
    <label>{{localize "AD2E.Gear.Scarcity"}} <input type="text" name="system.component.scarcity" value="{{system.component.scarcity}}"></label>
    <label class="ad2e-check"><input type="checkbox" name="system.component.perishable" {{checked system.component.perishable}}> {{localize "AD2E.Gear.Perishable"}}</label>
    <label class="ad2e-check"><input type="checkbox" name="system.component.laboratory" {{checked system.component.laboratory}}> {{localize "AD2E.Gear.Laboratory"}}</label>
    {{/if}}
    <label>{{localize "AD2E.Class.Source"}} <input type="text" name="system.source" value="{{system.source}}"></label>
    <label>{{localize "AD2E.Item.url"}} <input type="text" name="system.url" value="{{system.url}}"></label>
  </div>
  <p class="ad2e-note">{{summary}}</p>
  {{#if trap}}{{> "ad2e.trap-fields" trap=trap}}{{/if}}
  <label class="ad2e-notes">{{localize "AD2E.Item.notes"}}
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
</section>
